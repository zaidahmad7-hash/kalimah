{"n":90,"ar":"البلد","name":"Al-Balad","mean":"The City","type":"meccan","v":[{"a":["لَآ","أُقۡسِمُ","بِهَٰذَا","ٱلۡبَلَدِ"],"w":["Nay","I swear","by this","city"],"t":["lā","uq'simu","bihādhā","l-baladi"],"p":[1,2,3,4],"en":"I swear by this city, Makkah"},{"a":["وَأَنتَ","حِلُّۢ","بِهَٰذَا","ٱلۡبَلَدِ"],"w":["And you","(are) free (to dwell)","in this","city"],"t":["wa-anta","ḥillun","bihādhā","l-baladi"],"p":[1,2,3,4],"en":"And you, [O Muhammad], are free of restriction in this city"},{"a":["وَوَالِدࣲ","وَمَا","وَلَدَ"],"w":["And the begetter","and what","he begot"],"t":["wawālidin","wamā","walada"],"p":[1,2,3],"en":"And [by] the father and that which was born [of him]"},{"a":["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِي","كَبَدٍ"],"w":["Certainly","We have created","man","(to be) in","hardship"],"t":["laqad","khalaqnā","l-insāna","fī","kabadin"],"p":[1,2,3,4,5],"en":"We have certainly created man into hardship"},{"a":["أَيَحۡسَبُ","أَن","لَّن","يَقۡدِرَ","عَلَيۡهِ","أَحَدࣱ"],"w":["Does he think","that","not","has power","over him","anyone"],"t":["ayaḥsabu","an","lan","yaqdira","ʿalayhi","aḥadun"],"p":[1,2,3,4,5,6],"en":"Does he think that never will anyone overcome him"},{"a":["يَقُولُ","أَهۡلَكۡتُ","مَالࣰا","لُّبَدًا"],"w":["He will say","I have squandered","wealth","abundant"],"t":["yaqūlu","ahlaktu","mālan","lubadan"],"p":[1,2,3,4],"en":"He says, \"I have spent wealth in abundance"},{"a":["أَيَحۡسَبُ","أَن","لَّمۡ","يَرَهُۥٓ","أَحَدٌ"],"w":["Does he think","that","not","sees him","anyone"],"t":["ayaḥsabu","an","lam","yarahu","aḥadun"],"p":[1,2,3,4,5],"en":"Does he think that no one has seen him"},{"a":["أَلَمۡ","نَجۡعَل","لَّهُۥ","عَيۡنَيۡنِ"],"w":["Have not","We made","for him","two eyes"],"t":["alam","najʿal","lahu","ʿaynayni"],"p":[1,2,3,4],"en":"Have We not made for him two eyes"},{"a":["وَلِسَانࣰا","وَشَفَتَيۡنِ"],"w":["And a tongue","and two lips"],"t":["walisānan","washafatayni"],"p":[1,2],"en":"And a tongue and two lips"},{"a":["وَهَدَيۡنَٰهُ","ٱلنَّجۡدَيۡنِ"],"w":["And shown him","the two ways"],"t":["wahadaynāhu","l-najdayni"],"p":[1,2],"en":"And have shown him the two ways"},{"a":["فَلَا","ٱقۡتَحَمَ","ٱلۡعَقَبَةَ"],"w":["But not","he has attempted","the steep path"],"t":["falā","iq'taḥama","l-ʿaqabata"],"p":[1,2,3],"en":"But he has not broken through the difficult pass"},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡعَقَبَةُ"],"w":["And what","can make you know","what","the steep path (is)"],"t":["wamā","adrāka","mā","l-ʿaqabatu"],"p":[1,2,3,4],"en":"And what can make you know what is [breaking through] the difficult pass"},{"a":["فَكُّ","رَقَبَةٍ"],"w":["(It is) freeing","a neck"],"t":["fakku","raqabatin"],"p":[1,2],"en":"It is the freeing of a slave"},{"a":["أَوۡ","إِطۡعَٰمࣱ","فِي","يَوۡمࣲ","ذِي","مَسۡغَبَةࣲ"],"w":["Or","feeding","in","a day","of","severe hunger"],"t":["aw","iṭ'ʿāmun","fī","yawmin","dhī","masghabatin"],"p":[1,2,3,4,5,6],"en":"Or feeding on a day of severe hunger"},{"a":["يَتِيمࣰا","ذَا","مَقۡرَبَةٍ"],"w":["An orphan","of","near relationship"],"t":["yatīman","dhā","maqrabatin"],"p":[1,2,3],"en":"An orphan of near relationship"},{"a":["أَوۡ","مِسۡكِينࣰا","ذَا","مَتۡرَبَةࣲ"],"w":["Or","a needy person","in","misery"],"t":["aw","mis'kīnan","dhā","matrabatin"],"p":[1,2,3,4],"en":"Or a needy person in misery"},{"a":["ثُمَّ","كَانَ","مِنَ","ٱلَّذِينَ","ءَامَنُواْ","وَتَوَاصَوۡاْ","بِٱلصَّبۡرِ","وَتَوَاصَوۡاْ","بِٱلۡمَرۡحَمَةِ"],"w":["Then","he is","of","those who","believe","and enjoin (each other)","to patience","and enjoin (each other)","to compassion"],"t":["thumma","kāna","mina","alladhīna","āmanū","watawāṣaw","bil-ṣabri","watawāṣaw","bil-marḥamati"],"p":[1,2,3,4,5,6,7,8,9],"en":"And then being among those who believed and advised one another to patience and advised one another to compassion"},{"a":["أُوْلَـٰٓئِكَ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"w":["Those","(are the) companions","(of) the right (hand)"],"t":["ulāika","aṣḥābu","l-maymanati"],"p":[1,2,3],"en":"Those are the companions of the right"},{"a":["وَٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِنَا","هُمۡ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"w":["But those who","disbelieve","in Our Verses","they","(are the) companions","(of) the left (hand)"],"t":["wa-alladhīna","kafarū","biāyātinā","hum","aṣḥābu","l-mashamati"],"p":[1,2,3,4,5,6],"en":"But they who disbelieved in Our signs - those are the companions of the left"},{"a":["عَلَيۡهِمۡ","نَارࣱ","مُّؤۡصَدَةُۢ"],"w":["Over them","(will be the) Fire","closed in"],"t":["ʿalayhim","nārun","mu'ṣadatun"],"p":[1,2,3],"en":"Over them will be fire closed in"}]}