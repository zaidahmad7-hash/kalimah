{"n":94,"ar":"الشرح","name":"Ash-Sharh","mean":"The Relief","type":"meccan","v":[{"a":["أَلَمۡ","نَشۡرَحۡ","لَكَ","صَدۡرَكَ"],"w":["Have not","We expanded","for you","your breast"],"t":["alam","nashraḥ","laka","ṣadraka"],"p":[1,2,3,4],"en":"Did We not expand for you, [O Muhammad], your breast"},{"a":["وَوَضَعۡنَا","عَنكَ","وِزۡرَكَ"],"w":["And We removed","from you","your burden"],"t":["wawaḍaʿnā","ʿanka","wiz'raka"],"p":[1,2,3],"en":"And We removed from you your burden"},{"a":["ٱلَّذِيٓ","أَنقَضَ","ظَهۡرَكَ"],"w":["Which","weighed upon","your back"],"t":["alladhī","anqaḍa","ẓahraka"],"p":[1,2,3],"en":"Which had weighed upon your back"},{"a":["وَرَفَعۡنَا","لَكَ","ذِكۡرَكَ"],"w":["And We raised high","for you","your reputation"],"t":["warafaʿnā","laka","dhik'raka"],"p":[1,2,3],"en":"And raised high for you your repute"},{"a":["فَإِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرًا"],"w":["So indeed","with","the hardship","(is) ease"],"t":["fa-inna","maʿa","l-ʿus'ri","yus'ran"],"p":[1,2,3,4],"en":"For indeed, with hardship [will be] ease"},{"a":["إِنَّ","مَعَ","ٱلۡعُسۡرِ","يُسۡرࣰا"],"w":["Indeed","with","the hardship","(is) ease"],"t":["inna","maʿa","l-ʿus'ri","yus'ran"],"p":[1,2,3,4],"en":"Indeed, with hardship [will be] ease"},{"a":["فَإِذَا","فَرَغۡتَ","فَٱنصَبۡ"],"w":["So when","you have finished","then labor hard"],"t":["fa-idhā","faraghta","fa-inṣab"],"p":[1,2,3],"en":"So when you have finished [your duties], then stand up [for worship]"},{"a":["وَإِلَىٰ","رَبِّكَ","فَٱرۡغَب"],"w":["And to","your Lord","turn your attention"],"t":["wa-ilā","rabbika","fa-ir'ghab"],"p":[1,2,3],"en":"And to your Lord direct [your] longing"}]}