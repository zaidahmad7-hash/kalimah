{"n":95,"ar":"التين","name":"At-Tin","mean":"The Fig","type":"meccan","v":[{"a":["وَٱلتِّينِ","وَٱلزَّيۡتُونِ"],"w":["By the fig","and the olive"],"t":["wal-tīni","wal-zaytūni"],"p":[1,2],"en":"By the fig and the olive"},{"a":["وَطُورِ","سِينِينَ"],"w":["And (the) Mount","Sinai"],"t":["waṭūri","sīnīna"],"p":[1,2],"en":"And [by] Mount Sinai"},{"a":["وَهَٰذَا","ٱلۡبَلَدِ","ٱلۡأَمِينِ"],"w":["And this","[the] city","[the] secure"],"t":["wahādhā","l-baladi","l-amīni"],"p":[1,2,3],"en":"And [by] this secure city [Makkah]"},{"a":["لَقَدۡ","خَلَقۡنَا","ٱلۡإِنسَٰنَ","فِيٓ","أَحۡسَنِ","تَقۡوِيمࣲ"],"w":["Indeed","We created","man","in","(the) best","mould"],"t":["laqad","khalaqnā","l-insāna","fī","aḥsani","taqwīmin"],"p":[1,2,3,4,5,6],"en":"We have certainly created man in the best of stature"},{"a":["ثُمَّ","رَدَدۡنَٰهُ","أَسۡفَلَ","سَٰفِلِينَ"],"w":["Then","We returned him","(to the) lowest","(of the) low"],"t":["thumma","radadnāhu","asfala","sāfilīna"],"p":[1,2,3,4],"en":"Then We return him to the lowest of the low"},{"a":["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّـٰلِحَٰتِ","فَلَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونࣲ"],"w":["Except","those who","believe","and do","righteous deeds","then for them","(is a) reward","never","ending"],"t":["illā","alladhīna","āmanū","waʿamilū","l-ṣāliḥāti","falahum","ajrun","ghayru","mamnūnin"],"p":[1,2,3,4,5,6,7,8,9],"en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted"},{"a":["فَمَا","يُكَذِّبُكَ","بَعۡدُ","بِٱلدِّينِ"],"w":["Then what","causes you to deny","after (this)","the judgment"],"t":["famā","yukadhibuka","baʿdu","bil-dīni"],"p":[1,2,3,4],"en":"So what yet causes you to deny the Recompense"},{"a":["أَلَيۡسَ","ٱللَّهُ","بِأَحۡكَمِ","ٱلۡحَٰكِمِينَ"],"w":["Is not","Allah","(the) Most Just","(of) the Judges"],"t":["alaysa","l-lahu","bi-aḥkami","l-ḥākimīna"],"p":[1,2,3,4],"en":"Is not Allah the most just of judges"}]}