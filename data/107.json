{"n":107,"ar":"الماعون","name":"Al-Ma'un","mean":"The Small kindnesses","type":"meccan","v":[{"a":["أَرَءَيۡتَ","ٱلَّذِي","يُكَذِّبُ","بِٱلدِّينِ"],"w":["Have you seen","the one who","denies","the Judgment"],"t":["ara-ayta","alladhī","yukadhibu","bil-dīni"],"p":[1,2,3,4],"en":"Have you seen the one who denies the Recompense","ur":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟","i":["اَرَءَيۡتَ","الَّذِيۡ","يُكَذِّبُ","بِالدِّيۡنِؕ"]},{"a":["فَذَٰلِكَ","ٱلَّذِي","يَدُعُّ","ٱلۡيَتِيمَ"],"w":["Then that","(is) the one who","repulses","the orphan"],"t":["fadhālika","alladhī","yaduʿʿu","l-yatīma"],"p":[1,2,3,4],"en":"For that is the one who drives away the orphan","ur":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے","i":["فَذٰلِكَ","الَّذِيۡ","يَدُعُّ","الۡيَتِيۡمَۙ"]},{"a":["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","ٱلۡمِسۡكِينِ"],"w":["And (does) not","feel the urge","to","feed","the poor"],"t":["walā","yaḥuḍḍu","ʿalā","ṭaʿāmi","l-mis'kīni"],"p":[1,2,3,4,5],"en":"And does not encourage the feeding of the poor","ur":"اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا","i":["وَلَا","يَحُضُّ","عَلٰي","طَعَامِ","الۡمِسۡكِيۡنِؕ"]},{"a":["فَوَيۡلࣱ","لِّلۡمُصَلِّينَ"],"w":["So woe","to those who pray"],"t":["fawaylun","lil'muṣallīna"],"p":[1,2],"en":"So woe to those who pray","ur":"تو ایسے نمازیوں کی خرابی ہے","i":["فَوَيۡلٌ","لِّلۡمُصَلِّيۡنَۙ"]},{"a":["ٱلَّذِينَ","هُمۡ","عَن","صَلَاتِهِمۡ","سَاهُونَ"],"w":["Those who","[they]","about","their prayers","(are) neglectful"],"t":["alladhīna","hum","ʿan","ṣalātihim","sāhūna"],"p":[1,2,3,4,5],"en":"[But] who are heedless of their prayer","ur":"جو نماز کی طرف سے غافل رہتے ہیں","i":["الَّذِيۡنَ","هُمۡ","عَنۡ","صَلَاتِهِمۡ","سَاهُوۡنَۙ"]},{"a":["ٱلَّذِينَ","هُمۡ","يُرَآءُونَ"],"w":["Those who","[they]","make show"],"t":["alladhīna","hum","yurāūna"],"p":[1,2,3],"en":"Those who make show [of their deeds]","ur":"جو ریا کاری کرتے ہیں","i":["الَّذِيۡنَ","هُمۡ","يُرَآءُوۡنَۙ"]},{"a":["وَيَمۡنَعُونَ","ٱلۡمَاعُونَ"],"w":["And they deny","[the] small kindnesses"],"t":["wayamnaʿūna","l-māʿūna"],"p":[1,2],"en":"And withhold [simple] assistance","ur":"اور برتنے کی چیزیں عاریتہً نہیں دیتے","i":["وَيَمۡنَعُوۡنَ","الۡمَاعُوۡنَࣖ"]}]}