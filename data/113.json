{"n":113,"ar":"الفلق","name":"Al-Falaq","mean":"The Daybreak","type":"meccan","v":[{"a":["قُلۡ","أَعُوذُ","بِرَبِّ","ٱلۡفَلَقِ"],"w":["Say","I seek refuge","in (the) Lord","(of) the dawn"],"t":["qul","aʿūdhu","birabbi","l-falaqi"],"p":[1,2,3,4],"en":"Say, \"I seek refuge in the Lord of daybreak"},{"a":["مِن","شَرِّ","مَا","خَلَقَ"],"w":["From","(the) evil","(of) what","He created"],"t":["min","sharri","mā","khalaqa"],"p":[1,2,3,4],"en":"From the evil of that which He created"},{"a":["وَمِن","شَرِّ","غَاسِقٍ","إِذَا","وَقَبَ"],"w":["And from","(the) evil","(of) darkness","when","it spreads"],"t":["wamin","sharri","ghāsiqin","idhā","waqaba"],"p":[1,2,3,4,5],"en":"And from the evil of darkness when it settles"},{"a":["وَمِن","شَرِّ","ٱلنَّفَّـٰثَٰتِ","فِي","ٱلۡعُقَدِ"],"w":["And from","(the) evil","(of) the blowers","in","the knots"],"t":["wamin","sharri","l-nafāthāti","fī","l-ʿuqadi"],"p":[1,2,3,4,5],"en":"And from the evil of the blowers in knots"},{"a":["وَمِن","شَرِّ","حَاسِدٍ","إِذَا","حَسَدَ"],"w":["And from","(the) evil","(of) an envier","when","he envies"],"t":["wamin","sharri","ḥāsidin","idhā","ḥasada"],"p":[1,2,3,4,5],"en":"And from the evil of an envier when he envies"}]}