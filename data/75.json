{"n":75,"ar":"القيامة","name":"Al-Qiyamah","mean":"The Resurrection","type":"meccan","v":[{"a":["لَآ","أُقۡسِمُ","بِيَوۡمِ","ٱلۡقِيَٰمَةِ"],"w":["Nay","I swear","by (the) Day","(of) the Resurrection"],"t":["lā","uq'simu","biyawmi","l-qiyāmati"],"p":[1,2,3,4],"en":"I swear by the Day of Resurrection"},{"a":["وَلَآ","أُقۡسِمُ","بِٱلنَّفۡسِ","ٱللَّوَّامَةِ"],"w":["And nay","I swear","by the soul","self-accusing"],"t":["walā","uq'simu","bil-nafsi","l-lawāmati"],"p":[1,2,3,4],"en":"And I swear by the reproaching soul [to the certainty of resurrection]"},{"a":["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَلَّن","نَّجۡمَعَ","عِظَامَهُۥ"],"w":["Does think","[the] man","that not","We will assemble","his bones"],"t":["ayaḥsabu","l-insānu","allan","najmaʿa","ʿiẓāmahu"],"p":[1,2,3,4,5],"en":"Does man think that We will not assemble his bones"},{"a":["بَلَىٰ","قَٰدِرِينَ","عَلَىٰٓ","أَن","نُّسَوِّيَ","بَنَانَهُۥ"],"w":["Nay","(We are) Able","on","that","We can restore","his fingertips"],"t":["balā","qādirīna","ʿalā","an","nusawwiya","banānahu"],"p":[1,2,3,4,5,6],"en":"Yes. [We are] Able [even] to proportion his fingertips"},{"a":["بَلۡ","يُرِيدُ","ٱلۡإِنسَٰنُ","لِيَفۡجُرَ","أَمَامَهُۥ"],"w":["Nay","Desires","[the] man","to give (the) lie","(to) what is before him"],"t":["bal","yurīdu","l-insānu","liyafjura","amāmahu"],"p":[1,2,3,4,5],"en":"But man desires to continue in sin"},{"a":["يَسۡـَٔلُ","أَيَّانَ","يَوۡمُ","ٱلۡقِيَٰمَةِ"],"w":["He asks","When","(is the) Day","(of) the Resurrection"],"t":["yasalu","ayyāna","yawmu","l-qiyāmati"],"p":[1,2,3,4],"en":"He asks, \"When is the Day of Resurrection"},{"a":["فَإِذَا","بَرِقَ","ٱلۡبَصَرُ"],"w":["So when","is dazzled","the vision"],"t":["fa-idhā","bariqa","l-baṣaru"],"p":[1,2,3],"en":"So when vision is dazzled"},{"a":["وَخَسَفَ","ٱلۡقَمَرُ"],"w":["And becomes dark","the moon"],"t":["wakhasafa","l-qamaru"],"p":[1,2],"en":"And the moon darkens"},{"a":["وَجُمِعَ","ٱلشَّمۡسُ","وَٱلۡقَمَرُ"],"w":["And are joined","the sun","and the moon"],"t":["wajumiʿa","l-shamsu","wal-qamaru"],"p":[1,2,3],"en":"And the sun and the moon are joined"},{"a":["يَقُولُ","ٱلۡإِنسَٰنُ","يَوۡمَئِذٍ","أَيۡنَ","ٱلۡمَفَرُّ"],"w":["Will say","[the] man","that Day","Where","(is) the escape"],"t":["yaqūlu","l-insānu","yawma-idhin","ayna","l-mafaru"],"p":[1,2,3,4,5],"en":"Man will say on that Day, \"Where is the [place of] escape"},{"a":["كَلَّا","لَا","وَزَرَ"],"w":["By no means","(There is) no","refuge"],"t":["kallā","lā","wazara"],"p":[1,2,3],"en":"No! There is no refuge"},{"a":["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمُسۡتَقَرُّ"],"w":["To","your Lord","that Day","(is) the place of rest"],"t":["ilā","rabbika","yawma-idhin","l-mus'taqaru"],"p":[1,2,3,4],"en":"To your Lord, that Day, is the [place of] permanence"},{"a":["يُنَبَّؤُاْ","ٱلۡإِنسَٰنُ","يَوۡمَئِذِۭ","بِمَا","قَدَّمَ","وَأَخَّرَ"],"w":["Will be informed","[the] man","that Day","of what","he sent forth","and kept back"],"t":["yunabba-u","l-insānu","yawma-idhin","bimā","qaddama","wa-akhara"],"p":[1,2,3,4,5,6],"en":"Man will be informed that Day of what he sent ahead and kept back"},{"a":["بَلِ","ٱلۡإِنسَٰنُ","عَلَىٰ","نَفۡسِهِۦ","بَصِيرَةࣱ"],"w":["Nay","[The] man","against","himself","(will be) a witness"],"t":["bali","l-insānu","ʿalā","nafsihi","baṣīratun"],"p":[1,2,3,4,5],"en":"Rather, man, against himself, will be a witness"},{"a":["وَلَوۡ","أَلۡقَىٰ","مَعَاذِيرَهُۥ"],"w":["Even if","he presents","his excuses"],"t":["walaw","alqā","maʿādhīrahu"],"p":[1,2,3],"en":"Even if he presents his excuses"},{"a":["لَا","تُحَرِّكۡ","بِهِۦ","لِسَانَكَ","لِتَعۡجَلَ","بِهِۦٓ"],"w":["Not","move","with it","your tongue","to hasten","with it"],"t":["lā","tuḥarrik","bihi","lisānaka","litaʿjala","bihi"],"p":[1,2,3,4,5,6],"en":"Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an"},{"a":["إِنَّ","عَلَيۡنَا","جَمۡعَهُۥ","وَقُرۡءَانَهُۥ"],"w":["Indeed","upon Us","(is) its collection","and its recitation"],"t":["inna","ʿalaynā","jamʿahu","waqur'ānahu"],"p":[1,2,3,4],"en":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation"},{"a":["فَإِذَا","قَرَأۡنَٰهُ","فَٱتَّبِعۡ","قُرۡءَانَهُۥ"],"w":["And when","We have recited it","then follow","its recitation"],"t":["fa-idhā","qaranāhu","fa-ittabiʿ","qur'ānahu"],"p":[1,2,3,4],"en":"So when We have recited it [through Gabriel], then follow its recitation"},{"a":["ثُمَّ","إِنَّ","عَلَيۡنَا","بَيَانَهُۥ"],"w":["Then","indeed","upon Us","(is) its explanation"],"t":["thumma","inna","ʿalaynā","bayānahu"],"p":[1,2,3,4],"en":"Then upon Us is its clarification [to you]"},{"a":["كَلَّا","بَلۡ","تُحِبُّونَ","ٱلۡعَاجِلَةَ"],"w":["No","But","you love","the immediate"],"t":["kallā","bal","tuḥibbūna","l-ʿājilata"],"p":[1,2,3,4],"en":"No! But you love the immediate"},{"a":["وَتَذَرُونَ","ٱلۡأٓخِرَةَ"],"w":["And leave","the Hereafter"],"t":["watadharūna","l-ākhirata"],"p":[1,2],"en":"And leave the Hereafter"},{"a":["وُجُوهࣱ","يَوۡمَئِذࣲ","نَّاضِرَةٌ"],"w":["Faces","that Day","(will be) radiant"],"t":["wujūhun","yawma-idhin","nāḍiratun"],"p":[1,2,3],"en":"[Some] faces, that Day, will be radiant"},{"a":["إِلَىٰ","رَبِّهَا","نَاظِرَةࣱ"],"w":["Towards","their Lord","looking"],"t":["ilā","rabbihā","nāẓiratun"],"p":[1,2,3],"en":"Looking at their Lord"},{"a":["وَوُجُوهࣱ","يَوۡمَئِذِۭ","بَاسِرَةࣱ"],"w":["And faces","that Day","(will be) distorted"],"t":["wawujūhun","yawma-idhin","bāsiratun"],"p":[1,2,3],"en":"And [some] faces, that Day, will be contorted"},{"a":["تَظُنُّ","أَن","يُفۡعَلَ","بِهَا","فَاقِرَةࣱ"],"w":["Thinking","that","will be done","to them","backbreaking"],"t":["taẓunnu","an","yuf'ʿala","bihā","fāqiratun"],"p":[1,2,3,4,5],"en":"Expecting that there will be done to them [something] backbreaking"},{"a":["كَلَّآ","إِذَا","بَلَغَتِ","ٱلتَّرَاقِيَ"],"w":["No","When","it reaches","the collar bones"],"t":["kallā","idhā","balaghati","l-tarāqiya"],"p":[1,2,3,4],"en":"No! When the soul has reached the collar bones"},{"a":["وَقِيلَ","مَنۡۜ","رَاقࣲ"],"w":["And it is said","Who","(will) cure"],"t":["waqīla","man","rāqin"],"p":[1,2,3],"en":"And it is said, \"Who will cure [him]"},{"a":["وَظَنَّ","أَنَّهُ","ٱلۡفِرَاقُ"],"w":["And he is certain","that it","(is) the parting"],"t":["waẓanna","annahu","l-firāqu"],"p":[1,2,3],"en":"And the dying one is certain that it is the [time of] separation"},{"a":["وَٱلۡتَفَّتِ","ٱلسَّاقُ","بِٱلسَّاقِ"],"w":["And is wound","the leg","about the leg"],"t":["wal-tafati","l-sāqu","bil-sāqi"],"p":[1,2,3],"en":"And the leg is wound about the leg"},{"a":["إِلَىٰ","رَبِّكَ","يَوۡمَئِذٍ","ٱلۡمَسَاقُ"],"w":["To","your Lord","that Day","(will be) the driving"],"t":["ilā","rabbika","yawma-idhin","l-masāqu"],"p":[1,2,3,4],"en":"To your Lord, that Day, will be the procession"},{"a":["فَلَا","صَدَّقَ","وَلَا","صَلَّىٰ"],"w":["And not","he accepted (the) truth","and not","he prayed"],"t":["falā","ṣaddaqa","walā","ṣallā"],"p":[1,2,3,4],"en":"And the disbeliever had not believed, nor had he prayed"},{"a":["وَلَٰكِن","كَذَّبَ","وَتَوَلَّىٰ"],"w":["But","he denied","and turned away"],"t":["walākin","kadhaba","watawallā"],"p":[1,2,3],"en":"But [instead], he denied and turned away"},{"a":["ثُمَّ","ذَهَبَ","إِلَىٰٓ","أَهۡلِهِۦ","يَتَمَطَّىٰٓ"],"w":["Then","he went","to","his family","swaggering"],"t":["thumma","dhahaba","ilā","ahlihi","yatamaṭṭā"],"p":[1,2,3,4,5],"en":"And then he went to his people, swaggering [in pride]"},{"a":["أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰ"],"w":["Woe","to you","and woe"],"t":["awlā","laka","fa-awlā"],"p":[1,2,3],"en":"Woe to you, and woe"},{"a":["ثُمَّ","أَوۡلَىٰ","لَكَ","فَأَوۡلَىٰٓ"],"w":["Then","woe","to you","and woe"],"t":["thumma","awlā","laka","fa-awlā"],"p":[1,2,3,4],"en":"Then woe to you, and woe"},{"a":["أَيَحۡسَبُ","ٱلۡإِنسَٰنُ","أَن","يُتۡرَكَ","سُدًى"],"w":["Does think","man","that","he will be left","neglected"],"t":["ayaḥsabu","l-insānu","an","yut'raka","sudan"],"p":[1,2,3,4,5],"en":"Does man think that he will be left neglected"},{"a":["أَلَمۡ","يَكُ","نُطۡفَةࣰ","مِّن","مَّنِيࣲّ","يُمۡنَىٰ"],"w":["Was not","he","a semen-drop","of","semen","emitted"],"t":["alam","yaku","nuṭ'fatan","min","maniyyin","yum'nā"],"p":[1,2,3,4,5,6],"en":"Had he not been a sperm from semen emitted"},{"a":["ثُمَّ","كَانَ","عَلَقَةࣰ","فَخَلَقَ","فَسَوَّىٰ"],"w":["Then","he was","a clinging substance","then He created","and proportioned"],"t":["thumma","kāna","ʿalaqatan","fakhalaqa","fasawwā"],"p":[1,2,3,4,5],"en":"Then he was a clinging clot, and [Allah] created [his form] and proportioned [him]"},{"a":["فَجَعَلَ","مِنۡهُ","ٱلزَّوۡجَيۡنِ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰٓ"],"w":["Then made","of him","two kinds","(the) male","and the female"],"t":["fajaʿala","min'hu","l-zawjayni","l-dhakara","wal-unthā"],"p":[1,2,3,4,5],"en":"And made of him two mates, the male and the female"},{"a":["أَلَيۡسَ","ذَٰلِكَ","بِقَٰدِرٍ","عَلَىٰٓ","أَن","يُحۡـِۧيَ","ٱلۡمَوۡتَىٰ"],"w":["Is not","[that]","(He) Able","[over]","to","give life","(to) the dead"],"t":["alaysa","dhālika","biqādirin","ʿalā","an","yuḥ'yiya","l-mawtā"],"p":[1,2,3,4,5,6,7],"en":"Is not that [Creator] Able to give life to the dead"}]}