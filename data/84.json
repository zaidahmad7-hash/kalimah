{"n":84,"ar":"الإنشقاق","name":"Al-Inshiqaq","mean":"The Sundering","type":"meccan","v":[{"a":["إِذَا","ٱلسَّمَآءُ","ٱنشَقَّتۡ"],"w":["When","the sky","is split asunder"],"t":["idhā","l-samāu","inshaqqat"],"p":[1,2,3],"en":"When the sky has split [open]"},{"a":["وَأَذِنَتۡ","لِرَبِّهَا","وَحُقَّتۡ"],"w":["And has listened","to its Lord","and was obligated"],"t":["wa-adhinat","lirabbihā","waḥuqqat"],"p":[1,2,3],"en":"And has responded to its Lord and was obligated [to do so]"},{"a":["وَإِذَا","ٱلۡأَرۡضُ","مُدَّتۡ"],"w":["And when","the earth","is spread"],"t":["wa-idhā","l-arḍu","muddat"],"p":[1,2,3],"en":"And when the earth has been extended"},{"a":["وَأَلۡقَتۡ","مَا","فِيهَا","وَتَخَلَّتۡ"],"w":["And has cast out","what","(is) in it","and becomes empty"],"t":["wa-alqat","mā","fīhā","watakhallat"],"p":[1,2,3,4],"en":"And has cast out that within it and relinquished [it]"},{"a":["وَأَذِنَتۡ","لِرَبِّهَا","وَحُقَّتۡ"],"w":["And has listened","to its Lord","and was obligated"],"t":["wa-adhinat","lirabbihā","waḥuqqat"],"p":[1,2,3],"en":"And has responded to its Lord and was obligated [to do so]"},{"a":["يَـٰٓأَيُّهَا","ٱلۡإِنسَٰنُ","إِنَّكَ","كَادِحٌ","إِلَىٰ","رَبِّكَ","كَدۡحࣰا","فَمُلَٰقِيهِ"],"w":["O","mankind","Indeed, you","(are) laboring","to","your Lord","(with) exertion","and you (will) meet Him"],"t":["yāayyuhā","l-insānu","innaka","kādiḥun","ilā","rabbika","kadḥan","famulāqīhi"],"p":[1,2,3,4,5,6,7,8],"en":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it"},{"a":["فَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","بِيَمِينِهِۦ"],"w":["Then as for","(him) who","is given","his record","in his right (hand)"],"t":["fa-ammā","man","ūtiya","kitābahu","biyamīnihi"],"p":[1,2,3,4,5],"en":"Then as for he who is given his record in his right hand"},{"a":["فَسَوۡفَ","يُحَاسَبُ","حِسَابࣰا","يَسِيرࣰا"],"w":["Then soon","his account will be taken","an account","easy"],"t":["fasawfa","yuḥāsabu","ḥisāban","yasīran"],"p":[1,2,3,4],"en":"He will be judged with an easy account"},{"a":["وَيَنقَلِبُ","إِلَىٰٓ","أَهۡلِهِۦ","مَسۡرُورࣰا"],"w":["And he will return","to","his people","happily"],"t":["wayanqalibu","ilā","ahlihi","masrūran"],"p":[1,2,3,4],"en":"And return to his people in happiness"},{"a":["وَأَمَّا","مَنۡ","أُوتِيَ","كِتَٰبَهُۥ","وَرَآءَ","ظَهۡرِهِۦ"],"w":["But as for","(him) who","is given","his record","behind","his back"],"t":["wa-ammā","man","ūtiya","kitābahu","warāa","ẓahrihi"],"p":[1,2,3,4,5,6],"en":"But as for he who is given his record behind his back"},{"a":["فَسَوۡفَ","يَدۡعُواْ","ثُبُورࣰا"],"w":["Then soon","he will call","(for) destruction"],"t":["fasawfa","yadʿū","thubūran"],"p":[1,2,3],"en":"He will cry out for destruction"},{"a":["وَيَصۡلَىٰ","سَعِيرًا"],"w":["And he will burn","(in) a Blaze"],"t":["wayaṣlā","saʿīran"],"p":[1,2],"en":"And [enter to] burn in a Blaze"},{"a":["إِنَّهُۥ","كَانَ","فِيٓ","أَهۡلِهِۦ","مَسۡرُورًا"],"w":["Indeed, he","had been","among","his people","happy"],"t":["innahu","kāna","fī","ahlihi","masrūran"],"p":[1,2,3,4,5],"en":"Indeed, he had [once] been among his people in happiness"},{"a":["إِنَّهُۥ","ظَنَّ","أَن","لَّن","يَحُورَ"],"w":["Indeed, he","(had) thought","that","never","he would return"],"t":["innahu","ẓanna","an","lan","yaḥūra"],"p":[1,2,3,4,5],"en":"Indeed, he had thought he would never return [to Allah]"},{"a":["بَلَىٰٓۚ","إِنَّ","رَبَّهُۥ","كَانَ","بِهِۦ","بَصِيرࣰا"],"w":["Yes","Indeed","his Lord","was","of him","All-Seer"],"t":["balā","inna","rabbahu","kāna","bihi","baṣīran"],"p":[1,2,3,4,5,6],"en":"But yes! Indeed, his Lord was ever of him, Seeing"},{"a":["فَلَآ","أُقۡسِمُ","بِٱلشَّفَقِ"],"w":["But nay","I swear","by the twilight glow"],"t":["falā","uq'simu","bil-shafaqi"],"p":[1,2,3],"en":"So I swear by the twilight glow"},{"a":["وَٱلَّيۡلِ","وَمَا","وَسَقَ"],"w":["And the night","and what","it envelops"],"t":["wa-al-layli","wamā","wasaqa"],"p":[1,2,3],"en":"And [by] the night and what it envelops"},{"a":["وَٱلۡقَمَرِ","إِذَا","ٱتَّسَقَ"],"w":["And the moon","when","it becomes full"],"t":["wal-qamari","idhā","ittasaqa"],"p":[1,2,3],"en":"And [by] the moon when it becomes full"},{"a":["لَتَرۡكَبُنَّ","طَبَقًا","عَن","طَبَقࣲ"],"w":["You will surely embark","(to) stage","from","stage"],"t":["latarkabunna","ṭabaqan","ʿan","ṭabaqin"],"p":[1,2,3,4],"en":"[That] you will surely experience state after state"},{"a":["فَمَا","لَهُمۡ","لَا","يُؤۡمِنُونَ"],"w":["So what","(is) for them","not","they believe"],"t":["famā","lahum","lā","yu'minūna"],"p":[1,2,3,4],"en":"So what is [the matter] with them [that] they do not believe"},{"a":["وَإِذَا","قُرِئَ","عَلَيۡهِمُ","ٱلۡقُرۡءَانُ","لَا","يَسۡجُدُونَۤ۩"],"w":["And when","is recited","to them","the Quran","not","they prostrate"],"t":["wa-idhā","quri-a","ʿalayhimu","l-qur'ānu","lā","yasjudūna"],"p":[1,2,3,4,5,6],"en":"And when the Qur'an is recited to them, they do not prostrate [to Allah]"},{"a":["بَلِ","ٱلَّذِينَ","كَفَرُواْ","يُكَذِّبُونَ"],"w":["Nay","Those who","disbelieved","deny"],"t":["bali","alladhīna","kafarū","yukadhibūna"],"p":[1,2,3,4],"en":"But those who have disbelieved deny"},{"a":["وَٱللَّهُ","أَعۡلَمُ","بِمَا","يُوعُونَ"],"w":["And Allah","(is) most knowing","of what","they keep within themselves"],"t":["wal-lahu","aʿlamu","bimā","yūʿūna"],"p":[1,2,3,4],"en":"And Allah is most knowing of what they keep within themselves"},{"a":["فَبَشِّرۡهُم","بِعَذَابٍ","أَلِيمٍ"],"w":["so give them tidings","of a punishment","painful"],"t":["fabashir'hum","biʿadhābin","alīmin"],"p":[1,2,3],"en":"So give them tidings of a painful punishment"},{"a":["إِلَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّـٰلِحَٰتِ","لَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونِۭ"],"w":["Except","those who","believe","and do","righteous deeds","For them","(is) a reward","never","ending"],"t":["illā","alladhīna","āmanū","waʿamilū","l-ṣāliḥāti","lahum","ajrun","ghayru","mamnūnin"],"p":[1,2,3,4,5,6,7,8,9],"en":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted"}]}