{"n":102,"ar":"التكاثر","name":"At-Takathur","mean":"The Rivalry in world increase","type":"meccan","v":[{"a":["أَلۡهَىٰكُمُ","ٱلتَّكَاثُرُ"],"w":["Diverts you","the competition to increase"],"t":["alhākumu","l-takāthuru"],"p":[1,2],"en":"Competition in [worldly] increase diverts you"},{"a":["حَتَّىٰ","زُرۡتُمُ","ٱلۡمَقَابِرَ"],"w":["Until","you visit","the graves"],"t":["ḥattā","zur'tumu","l-maqābira"],"p":[1,2,3],"en":"Until you visit the graveyards"},{"a":["كَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"w":["Nay","Soon","you will know"],"t":["kallā","sawfa","taʿlamūna"],"p":[1,2,3],"en":"No! You are going to know"},{"a":["ثُمَّ","كَلَّا","سَوۡفَ","تَعۡلَمُونَ"],"w":["Then","nay","Soon","you will know"],"t":["thumma","kallā","sawfa","taʿlamūna"],"p":[1,2,3,4],"en":"Then no! You are going to know"},{"a":["كَلَّا","لَوۡ","تَعۡلَمُونَ","عِلۡمَ","ٱلۡيَقِينِ"],"w":["Nay","If","you know","(with) a knowledge","(of) certainty"],"t":["kallā","law","taʿlamūna","ʿil'ma","l-yaqīni"],"p":[1,2,3,4,5],"en":"No! If you only knew with knowledge of certainty"},{"a":["لَتَرَوُنَّ","ٱلۡجَحِيمَ"],"w":["Surely you will see","the Hellfire"],"t":["latarawunna","l-jaḥīma"],"p":[1,2],"en":"You will surely see the Hellfire"},{"a":["ثُمَّ","لَتَرَوُنَّهَا","عَيۡنَ","ٱلۡيَقِينِ"],"w":["Then","surely you will see it","(with the) eye","(of) certainty"],"t":["thumma","latarawunnahā","ʿayna","l-yaqīni"],"p":[1,2,3,4],"en":"Then you will surely see it with the eye of certainty"},{"a":["ثُمَّ","لَتُسۡـَٔلُنَّ","يَوۡمَئِذٍ","عَنِ","ٱلنَّعِيمِ"],"w":["Then","surely you will be asked","that Day","about","the pleasures"],"t":["thumma","latus'alunna","yawma-idhin","ʿani","l-naʿīmi"],"p":[1,2,3,4,5],"en":"Then you will surely be asked that Day about pleasure"}]}