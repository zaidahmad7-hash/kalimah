{"n":104,"ar":"الهمزة","name":"Al-Humazah","mean":"The Traducer","type":"meccan","v":[{"a":["وَيۡلࣱ","لِّكُلِّ","هُمَزَةࣲ","لُّمَزَةٍ"],"w":["Woe","to every","slanderer","backbiter"],"t":["waylun","likulli","humazatin","lumazatin"],"p":[1,2,3,4],"en":"Woe to every scorner and mocker"},{"a":["ٱلَّذِي","جَمَعَ","مَالࣰا","وَعَدَّدَهُۥ"],"w":["The one who","collects","wealth","and counts it"],"t":["alladhī","jamaʿa","mālan","waʿaddadahu"],"p":[1,2,3,4],"en":"Who collects wealth and [continuously] counts it"},{"a":["يَحۡسَبُ","أَنَّ","مَالَهُۥٓ","أَخۡلَدَهُۥ"],"w":["Thinking","that","his wealth","will make him immortal"],"t":["yaḥsabu","anna","mālahu","akhladahu"],"p":[1,2,3,4],"en":"He thinks that his wealth will make him immortal"},{"a":["كَلَّاۖ","لَيُنۢبَذَنَّ","فِي","ٱلۡحُطَمَةِ"],"w":["Nay","Surely he will be thrown","in","the Crusher"],"t":["kallā","layunbadhanna","fī","l-ḥuṭamati"],"p":[1,2,3,4],"en":"No! He will surely be thrown into the Crusher"},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","ٱلۡحُطَمَةُ"],"w":["And what","will make you know","what","the Crusher (is)"],"t":["wamā","adrāka","mā","l-ḥuṭamatu"],"p":[1,2,3,4],"en":"And what can make you know what is the Crusher"},{"a":["نَارُ","ٱللَّهِ","ٱلۡمُوقَدَةُ"],"w":["A Fire","Allah","kindled"],"t":["nāru","l-lahi","l-mūqadatu"],"p":[1,2,3],"en":"It is the fire of Allah, [eternally] fueled"},{"a":["ٱلَّتِي","تَطَّلِعُ","عَلَى","ٱلۡأَفۡـِٔدَةِ"],"w":["Which","mounts up","to","the hearts"],"t":["allatī","taṭṭaliʿu","ʿalā","l-afidati"],"p":[1,2,3,4],"en":"Which mounts directed at the hearts"},{"a":["إِنَّهَا","عَلَيۡهِم","مُّؤۡصَدَةࣱ"],"w":["Indeed, it","(will be) upon them","closed over"],"t":["innahā","ʿalayhim","mu'ṣadatun"],"p":[1,2,3],"en":"Indeed, Hellfire will be closed down upon them"},{"a":["فِي","عَمَدࣲ","مُّمَدَّدَةِۭ"],"w":["In","columns","extended"],"t":["fī","ʿamadin","mumaddadatin"],"p":[1,2,3],"en":"In extended columns"}]}