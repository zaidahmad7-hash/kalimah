{"n":100,"ar":"العاديات","name":"Al-'Adiyat","mean":"The Courser","type":"meccan","v":[{"a":["وَٱلۡعَٰدِيَٰتِ","ضَبۡحࣰا"],"w":["By the racers","panting"],"t":["wal-ʿādiyāti","ḍabḥan"],"p":[1,2],"en":"By the racers, panting"},{"a":["فَٱلۡمُورِيَٰتِ","قَدۡحࣰا"],"w":["And the producers of sparks","striking"],"t":["fal-mūriyāti","qadḥan"],"p":[1,2],"en":"And the producers of sparks [when] striking"},{"a":["فَٱلۡمُغِيرَٰتِ","صُبۡحࣰا"],"w":["And the chargers","(at) dawn"],"t":["fal-mughīrāti","ṣub'ḥan"],"p":[1,2],"en":"And the chargers at dawn"},{"a":["فَأَثَرۡنَ","بِهِۦ","نَقۡعࣰا"],"w":["Then raise","thereby","dust"],"t":["fa-atharna","bihi","naqʿan"],"p":[1,2,3],"en":"Stirring up thereby [clouds of] dust"},{"a":["فَوَسَطۡنَ","بِهِۦ","جَمۡعًا"],"w":["Then penetrate (in the) center","thereby","collectively"],"t":["fawasaṭna","bihi","jamʿan"],"p":[1,2,3],"en":"Arriving thereby in the center collectively"},{"a":["إِنَّ","ٱلۡإِنسَٰنَ","لِرَبِّهِۦ","لَكَنُودࣱ"],"w":["Indeed","mankind","to his Lord","(is) surely ungrateful"],"t":["inna","l-insāna","lirabbihi","lakanūdun"],"p":[1,2,3,4],"en":"Indeed mankind, to his Lord, is ungrateful"},{"a":["وَإِنَّهُۥ","عَلَىٰ","ذَٰلِكَ","لَشَهِيدࣱ"],"w":["And indeed, he","on","that","surely (is) a witness"],"t":["wa-innahu","ʿalā","dhālika","lashahīdun"],"p":[1,2,3,4],"en":"And indeed, he is to that a witness"},{"a":["وَإِنَّهُۥ","لِحُبِّ","ٱلۡخَيۡرِ","لَشَدِيدٌ"],"w":["And indeed he","in (the) love","(of) wealth","(is) surely intense"],"t":["wa-innahu","liḥubbi","l-khayri","lashadīdun"],"p":[1,2,3,4],"en":"And indeed he is, in love of wealth, intense"},{"a":["۞أَفَلَا","يَعۡلَمُ","إِذَا","بُعۡثِرَ","مَا","فِي","ٱلۡقُبُورِ"],"w":["But does not","he know","when","will be scattered","what","(is) in","the graves"],"t":["afalā","yaʿlamu","idhā","buʿ'thira","mā","fī","l-qubūri"],"p":[1,2,3,4,5,6,7],"en":"But does he not know that when the contents of the graves are scattered"},{"a":["وَحُصِّلَ","مَا","فِي","ٱلصُّدُورِ"],"w":["And is made apparent","what","(is) in","the breasts"],"t":["waḥuṣṣila","mā","fī","l-ṣudūri"],"p":[1,2,3,4],"en":"And that within the breasts is obtained"},{"a":["إِنَّ","رَبَّهُم","بِهِمۡ","يَوۡمَئِذࣲ","لَّخَبِيرُۢ"],"w":["Indeed","their Lord","about them","that Day","(is) surely All-Aware"],"t":["inna","rabbahum","bihim","yawma-idhin","lakhabīrun"],"p":[1,2,3,4,5],"en":"Indeed, their Lord with them, that Day, is [fully] Acquainted"}]}