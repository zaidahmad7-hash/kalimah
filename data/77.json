{"n":77,"ar":"المرسلات","name":"Al-Mursalat","mean":"The Emissaries","type":"meccan","v":[{"a":["وَٱلۡمُرۡسَلَٰتِ","عُرۡفࣰا"],"w":["By the ones sent forth","one after another"],"t":["wal-mur'salāti","ʿur'fan"],"p":[1,2],"en":"By those [winds] sent forth in gusts"},{"a":["فَٱلۡعَٰصِفَٰتِ","عَصۡفࣰا"],"w":["And the winds that blow","violently"],"t":["fal-ʿāṣifāti","ʿaṣfan"],"p":[1,2],"en":"And the winds that blow violently"},{"a":["وَٱلنَّـٰشِرَٰتِ","نَشۡرࣰا"],"w":["And the ones that scatter","far and wide"],"t":["wal-nāshirāti","nashran"],"p":[1,2],"en":"And [by] the winds that spread [clouds]"},{"a":["فَٱلۡفَٰرِقَٰتِ","فَرۡقࣰا"],"w":["And those who separate","(by the) Criterion"],"t":["fal-fāriqāti","farqan"],"p":[1,2],"en":"And those [angels] who bring criterion"},{"a":["فَٱلۡمُلۡقِيَٰتِ","ذِكۡرًا"],"w":["And those who bring down","(the) Reminder"],"t":["fal-mul'qiyāti","dhik'ran"],"p":[1,2],"en":"And those [angels] who deliver a message"},{"a":["عُذۡرًا","أَوۡ","نُذۡرًا"],"w":["(As) justification","or","warning"],"t":["ʿudh'ran","aw","nudh'ran"],"p":[1,2,3],"en":"As justification or warning"},{"a":["إِنَّمَا","تُوعَدُونَ","لَوَٰقِعࣱ"],"w":["Indeed, what","you are promised","will surely occur"],"t":["innamā","tūʿadūna","lawāqiʿun"],"p":[1,2,3],"en":"Indeed, what you are promised is to occur"},{"a":["فَإِذَا","ٱلنُّجُومُ","طُمِسَتۡ"],"w":["So when","the stars","are obliterated"],"t":["fa-idhā","l-nujūmu","ṭumisat"],"p":[1,2,3],"en":"So when the stars are obliterated"},{"a":["وَإِذَا","ٱلسَّمَآءُ","فُرِجَتۡ"],"w":["And when","the heaven","is cleft asunder"],"t":["wa-idhā","l-samāu","furijat"],"p":[1,2,3],"en":"And when the heaven is opened"},{"a":["وَإِذَا","ٱلۡجِبَالُ","نُسِفَتۡ"],"w":["And when","the mountains","are blown away"],"t":["wa-idhā","l-jibālu","nusifat"],"p":[1,2,3],"en":"And when the mountains are blown away"},{"a":["وَإِذَا","ٱلرُّسُلُ","أُقِّتَتۡ"],"w":["And when","the Messengers","are gathered to their appointed time"],"t":["wa-idhā","l-rusulu","uqqitat"],"p":[1,2,3],"en":"And when the messengers' time has come"},{"a":["لِأَيِّ","يَوۡمٍ","أُجِّلَتۡ"],"w":["For what","Day","are (these) postponed"],"t":["li-ayyi","yawmin","ujjilat"],"p":[1,2,3],"en":"For what Day was it postponed"},{"a":["لِيَوۡمِ","ٱلۡفَصۡلِ"],"w":["For (the) Day","(of) Judgment"],"t":["liyawmi","l-faṣli"],"p":[1,2],"en":"For the Day of Judgement"},{"a":["وَمَآ","أَدۡرَىٰكَ","مَا","يَوۡمُ","ٱلۡفَصۡلِ"],"w":["And what","will make you know","what","(is the) Day","(of) the Judgment"],"t":["wamā","adrāka","mā","yawmu","l-faṣli"],"p":[1,2,3,4,5],"en":"And what can make you know what is the Day of Judgement"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["أَلَمۡ","نُهۡلِكِ","ٱلۡأَوَّلِينَ"],"w":["Did not","We destroy","the former (people)"],"t":["alam","nuh'liki","l-awalīna"],"p":[1,2,3],"en":"Did We not destroy the former peoples"},{"a":["ثُمَّ","نُتۡبِعُهُمُ","ٱلۡأٓخِرِينَ"],"w":["Then","We follow them up","(with) the later ones"],"t":["thumma","nut'biʿuhumu","l-ākhirīna"],"p":[1,2,3],"en":"Then We will follow them with the later ones"},{"a":["كَذَٰلِكَ","نَفۡعَلُ","بِٱلۡمُجۡرِمِينَ"],"w":["Thus","We deal","with the criminals"],"t":["kadhālika","nafʿalu","bil-muj'rimīna"],"p":[1,2,3],"en":"Thus do We deal with the criminals"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["أَلَمۡ","نَخۡلُقكُّم","مِّن","مَّآءࣲ","مَّهِينࣲ"],"w":["Did not","We create you","from","a water","despicable"],"t":["alam","nakhluqkkum","min","māin","mahīnin"],"p":[1,2,3,4,5],"en":"Did We not create you from a liquid disdained"},{"a":["فَجَعَلۡنَٰهُ","فِي","قَرَارࣲ","مَّكِينٍ"],"w":["Then We placed it","in","an abode","safe"],"t":["fajaʿalnāhu","fī","qarārin","makīnin"],"p":[1,2,3,4],"en":"And We placed it in a firm lodging"},{"a":["إِلَىٰ","قَدَرࣲ","مَّعۡلُومࣲ"],"w":["For","a period","known"],"t":["ilā","qadarin","maʿlūmin"],"p":[1,2,3],"en":"For a known extent"},{"a":["فَقَدَرۡنَا","فَنِعۡمَ","ٱلۡقَٰدِرُونَ"],"w":["So We measured","and Best","(are We to) measure"],"t":["faqadarnā","faniʿ'ma","l-qādirūna"],"p":[1,2,3],"en":"And We determined [it], and excellent [are We] to determine"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["أَلَمۡ","نَجۡعَلِ","ٱلۡأَرۡضَ","كِفَاتًا"],"w":["Have not","We made","the earth","a receptacle"],"t":["alam","najʿali","l-arḍa","kifātan"],"p":[1,2,3,4],"en":"Have We not made the earth a container"},{"a":["أَحۡيَآءࣰ","وَأَمۡوَٰتࣰا"],"w":["(For the) living","and (the) dead"],"t":["aḥyāan","wa-amwātan"],"p":[1,2],"en":"Of the living and the dead"},{"a":["وَجَعَلۡنَا","فِيهَا","رَوَٰسِيَ","شَٰمِخَٰتࣲ","وَأَسۡقَيۡنَٰكُم","مَّآءࣰ","فُرَاتࣰا"],"w":["And We made","therein","firmly set mountains","lofty","and We gave you to drink","water ","sweet"],"t":["wajaʿalnā","fīhā","rawāsiya","shāmikhātin","wa-asqaynākum","māan","furātan"],"p":[1,2,3,4,5,6,7],"en":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["ٱنطَلِقُوٓاْ","إِلَىٰ","مَا","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"w":["Proceed","to","what","you used to","in it","deny"],"t":["inṭaliqū","ilā","mā","kuntum","bihi","tukadhibūna"],"p":[1,2,3,4,5,6],"en":"[They will be told], \"Proceed to that which you used to deny"},{"a":["ٱنطَلِقُوٓاْ","إِلَىٰ","ظِلࣲّ","ذِي","ثَلَٰثِ","شُعَبࣲ"],"w":["Proceed","to","a shadow","having","three","columns"],"t":["inṭaliqū","ilā","ẓillin","dhī","thalāthi","shuʿabin"],"p":[1,2,3,4,5,6],"en":"Proceed to a shadow [of smoke] having three columns"},{"a":["لَّا","ظَلِيلࣲ","وَلَا","يُغۡنِي","مِنَ","ٱللَّهَبِ"],"w":["No","cool shade","and not","availing","against","the flame"],"t":["lā","ẓalīlin","walā","yugh'nī","mina","l-lahabi"],"p":[1,2,3,4,5,6],"en":"[But having] no cool shade and availing not against the flame"},{"a":["إِنَّهَا","تَرۡمِي","بِشَرَرࣲ","كَٱلۡقَصۡرِ"],"w":["Indeed, it","throws up","sparks","as the fortress"],"t":["innahā","tarmī","bishararin","kal-qaṣri"],"p":[1,2,3,4],"en":"Indeed, it throws sparks [as huge] as a fortress"},{"a":["كَأَنَّهُۥ","جِمَٰلَتࣱ","صُفۡرࣱ"],"w":["As if they (were)","camels","yellow"],"t":["ka-annahu","jimālatun","ṣuf'run"],"p":[1,2,3],"en":"As if they were yellowish [black] camels"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["هَٰذَا","يَوۡمُ","لَا","يَنطِقُونَ"],"w":["This","(is) a Day","not","they will speak"],"t":["hādhā","yawmu","lā","yanṭiqūna"],"p":[1,2,3,4],"en":"This is a Day they will not speak"},{"a":["وَلَا","يُؤۡذَنُ","لَهُمۡ","فَيَعۡتَذِرُونَ"],"w":["And not","will it be permitted","for them","to make excuses"],"t":["walā","yu'dhanu","lahum","fayaʿtadhirūna"],"p":[1,2,3,4],"en":"Nor will it be permitted for them to make an excuse"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["هَٰذَا","يَوۡمُ","ٱلۡفَصۡلِۖ","جَمَعۡنَٰكُمۡ","وَٱلۡأَوَّلِينَ"],"w":["This","(is the) Day","(of) Judgment","We have gathered you","and the former (people)"],"t":["hādhā","yawmu","l-faṣli","jamaʿnākum","wal-awalīna"],"p":[1,2,3,4,5],"en":"This is the Day of Judgement; We will have assembled you and the former peoples"},{"a":["فَإِن","كَانَ","لَكُمۡ","كَيۡدࣱ","فَكِيدُونِ"],"w":["So if","is","for you","a plan","then plan against Me"],"t":["fa-in","kāna","lakum","kaydun","fakīdūni"],"p":[1,2,3,4,5],"en":"So if you have a plan, then plan against Me"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["إِنَّ","ٱلۡمُتَّقِينَ","فِي","ظِلَٰلࣲ","وَعُيُونࣲ"],"w":["Indeed","the righteous","(will be) in","shades","and springs"],"t":["inna","l-mutaqīna","fī","ẓilālin","waʿuyūnin"],"p":[1,2,3,4,5],"en":"Indeed, the righteous will be among shades and springs"},{"a":["وَفَوَٰكِهَ","مِمَّا","يَشۡتَهُونَ"],"w":["And fruits","from what","they desire"],"t":["wafawākiha","mimmā","yashtahūna"],"p":[1,2,3],"en":"And fruits from whatever they desire"},{"a":["كُلُواْ","وَٱشۡرَبُواْ","هَنِيٓـَٔۢا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"w":["Eat","and drink","(in) satisfaction","for what","you used to","do"],"t":["kulū","wa-ish'rabū","hanīan","bimā","kuntum","taʿmalūna"],"p":[1,2,3,4,5,6],"en":"[Being told], \"Eat and drink in satisfaction for what you used to do"},{"a":["إِنَّا","كَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"w":["Indeed, We","thus","reward","the good-doers"],"t":["innā","kadhālika","najzī","l-muḥ'sinīna"],"p":[1,2,3,4],"en":"Indeed, We thus reward the doers of good"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["كُلُواْ","وَتَمَتَّعُواْ","قَلِيلًا","إِنَّكُم","مُّجۡرِمُونَ"],"w":["Eat","and enjoy yourselves","a little","indeed, you","(are) criminals"],"t":["kulū","watamattaʿū","qalīlan","innakum","muj'rimūna"],"p":[1,2,3,4,5],"en":"[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["وَإِذَا","قِيلَ","لَهُمُ","ٱرۡكَعُواْ","لَا","يَرۡكَعُونَ"],"w":["And when","it is said","to them","Bow","not","they bow"],"t":["wa-idhā","qīla","lahumu","ir'kaʿū","lā","yarkaʿūna"],"p":[1,2,3,4,5,6],"en":"And when it is said to them, \"Bow [in prayer],\" they do not bow"},{"a":["وَيۡلࣱ","يَوۡمَئِذࣲ","لِّلۡمُكَذِّبِينَ"],"w":["Woe","that Day","to the deniers"],"t":["waylun","yawma-idhin","lil'mukadhibīna"],"p":[1,2,3],"en":"Woe, that Day, to the deniers"},{"a":["فَبِأَيِّ","حَدِيثِۭ","بَعۡدَهُۥ","يُؤۡمِنُونَ"],"w":["Then in what","statement","after it","will they believe"],"t":["fabi-ayyi","ḥadīthin","baʿdahu","yu'minūna"],"p":[1,2,3,4],"en":"Then in what statement after the Qur'an will they believe"}]}