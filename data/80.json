{"n":80,"ar":"عبس","name":"'Abasa","mean":"He Frowned","type":"meccan","v":[{"a":["عَبَسَ","وَتَوَلَّىٰٓ"],"w":["He frowned","and turned away"],"t":["ʿabasa","watawallā"],"p":[1,2],"en":"The Prophet frowned and turned away"},{"a":["أَن","جَآءَهُ","ٱلۡأَعۡمَىٰ"],"w":["Because","came to him","the blind man"],"t":["an","jāahu","l-aʿmā"],"p":[1,2,3],"en":"Because there came to him the blind man, [interrupting]"},{"a":["وَمَا","يُدۡرِيكَ","لَعَلَّهُۥ","يَزَّكَّىٰٓ"],"w":["But what","would make you know","that he might","purify himself"],"t":["wamā","yud'rīka","laʿallahu","yazzakkā"],"p":[1,2,3,4],"en":"But what would make you perceive, [O Muhammad], that perhaps he might be purified"},{"a":["أَوۡ","يَذَّكَّرُ","فَتَنفَعَهُ","ٱلذِّكۡرَىٰٓ"],"w":["Or","be reminded","so would benefit him","the reminder"],"t":["aw","yadhakkaru","fatanfaʿahu","l-dhik'rā"],"p":[1,2,3,4],"en":"Or be reminded and the remembrance would benefit him"},{"a":["أَمَّا","مَنِ","ٱسۡتَغۡنَىٰ"],"w":["As for","(him) who","considers himself free from need"],"t":["ammā","mani","is'taghnā"],"p":[1,2,3],"en":"As for he who thinks himself without need"},{"a":["فَأَنتَ","لَهُۥ","تَصَدَّىٰ"],"w":["So you","to him","give attention"],"t":["fa-anta","lahu","taṣaddā"],"p":[1,2,3],"en":"To him you give attention"},{"a":["وَمَا","عَلَيۡكَ","أَلَّا","يَزَّكَّىٰ"],"w":["And not","upon you","that not","he purifies himself"],"t":["wamā","ʿalayka","allā","yazzakkā"],"p":[1,2,3,4],"en":"And not upon you [is any blame] if he will not be purified"},{"a":["وَأَمَّا","مَن","جَآءَكَ","يَسۡعَىٰ"],"w":["But as for","(he) who","came to you","striving"],"t":["wa-ammā","man","jāaka","yasʿā"],"p":[1,2,3,4],"en":"But as for he who came to you striving [for knowledge]"},{"a":["وَهُوَ","يَخۡشَىٰ"],"w":["While he","fears"],"t":["wahuwa","yakhshā"],"p":[1,2],"en":"While he fears [Allah]"},{"a":["فَأَنتَ","عَنۡهُ","تَلَهَّىٰ"],"w":["But you","from him","(are) distracted"],"t":["fa-anta","ʿanhu","talahhā"],"p":[1,2,3],"en":"From him you are distracted"},{"a":["كَلَّآ","إِنَّهَا","تَذۡكِرَةࣱ"],"w":["Nay","Indeed, it","(is) a reminder"],"t":["kallā","innahā","tadhkiratun"],"p":[1,2,3],"en":"No! Indeed, these verses are a reminder"},{"a":["فَمَن","شَآءَ","ذَكَرَهُۥ"],"w":["So whosoever","wills","may remember it"],"t":["faman","shāa","dhakarahu"],"p":[1,2,3],"en":"So whoever wills may remember it"},{"a":["فِي","صُحُفࣲ","مُّكَرَّمَةࣲ"],"w":["In","sheets","honored"],"t":["fī","ṣuḥufin","mukarramatin"],"p":[1,2,3],"en":"[It is recorded] in honored sheets"},{"a":["مَّرۡفُوعَةࣲ","مُّطَهَّرَةِۭ"],"w":["Exalted","purified"],"t":["marfūʿatin","muṭahharatin"],"p":[1,2],"en":"Exalted and purified"},{"a":["بِأَيۡدِي","سَفَرَةࣲ"],"w":["In (the) hands","(of) scribes"],"t":["bi-aydī","safaratin"],"p":[1,2],"en":"[Carried] by the hands of messenger-angels"},{"a":["كِرَامِۭ","بَرَرَةࣲ"],"w":["Noble","dutiful"],"t":["kirāmin","bararatin"],"p":[1,2],"en":"Noble and dutiful"},{"a":["قُتِلَ","ٱلۡإِنسَٰنُ","مَآ","أَكۡفَرَهُۥ"],"w":["Is destroyed","[the] man","how","ungrateful is he"],"t":["qutila","l-insānu","mā","akfarahu"],"p":[1,2,3,4],"en":"Cursed is man; how disbelieving is he"},{"a":["مِنۡ","أَيِّ","شَيۡءٍ","خَلَقَهُۥ"],"w":["From","what","thing","He created him"],"t":["min","ayyi","shayin","khalaqahu"],"p":[1,2,3,4],"en":"From what substance did He create him"},{"a":["مِن","نُّطۡفَةٍ","خَلَقَهُۥ","فَقَدَّرَهُۥ"],"w":["From","a semen-drop","He created him","then He proportioned him"],"t":["min","nuṭ'fatin","khalaqahu","faqaddarahu"],"p":[1,2,3,4],"en":"From a sperm-drop He created him and destined for him"},{"a":["ثُمَّ","ٱلسَّبِيلَ","يَسَّرَهُۥ"],"w":["Then","the way","He made easy for him"],"t":["thumma","l-sabīla","yassarahu"],"p":[1,2,3],"en":"Then He eased the way for him"},{"a":["ثُمَّ","أَمَاتَهُۥ","فَأَقۡبَرَهُۥ"],"w":["Then","He causes him to die","and provides a grave for him"],"t":["thumma","amātahu","fa-aqbarahu"],"p":[1,2,3],"en":"Then He causes his death and provides a grave for him"},{"a":["ثُمَّ","إِذَا","شَآءَ","أَنشَرَهُۥ"],"w":["Then","when","He wills","He will resurrect him"],"t":["thumma","idhā","shāa","ansharahu"],"p":[1,2,3,4],"en":"Then when He wills, He will resurrect him"},{"a":["كَلَّا","لَمَّا","يَقۡضِ","مَآ","أَمَرَهُۥ"],"w":["Nay","Not","he has accomplished","what","He commanded him"],"t":["kallā","lammā","yaqḍi","mā","amarahu"],"p":[1,2,3,4,5],"en":"No! Man has not yet accomplished what He commanded him"},{"a":["فَلۡيَنظُرِ","ٱلۡإِنسَٰنُ","إِلَىٰ","طَعَامِهِۦٓ"],"w":["Then let look","the man","at","his food"],"t":["falyanẓuri","l-insānu","ilā","ṭaʿāmihi"],"p":[1,2,3,4],"en":"Then let mankind look at his food"},{"a":["أَنَّا","صَبَبۡنَا","ٱلۡمَآءَ","صَبࣰّا"],"w":["That [We]","[We] poured","the water","(in) abundance"],"t":["annā","ṣababnā","l-māa","ṣabban"],"p":[1,2,3,4],"en":"How We poured down water in torrents"},{"a":["ثُمَّ","شَقَقۡنَا","ٱلۡأَرۡضَ","شَقࣰّا"],"w":["Then","We cleaved","the earth","splitting"],"t":["thumma","shaqaqnā","l-arḍa","shaqqan"],"p":[1,2,3,4],"en":"Then We broke open the earth, splitting [it with sprouts]"},{"a":["فَأَنۢبَتۡنَا","فِيهَا","حَبࣰّا"],"w":["Then We caused to grow","therein","grain"],"t":["fa-anbatnā","fīhā","ḥabban"],"p":[1,2,3],"en":"And caused to grow within it grain"},{"a":["وَعِنَبࣰا","وَقَضۡبࣰا"],"w":["And grapes","and green fodder"],"t":["waʿinaban","waqaḍban"],"p":[1,2],"en":"And grapes and herbage"},{"a":["وَزَيۡتُونࣰا","وَنَخۡلࣰا"],"w":["And olive","and date-palms"],"t":["wazaytūnan","wanakhlan"],"p":[1,2],"en":"And olive and palm trees"},{"a":["وَحَدَآئِقَ","غُلۡبࣰا"],"w":["And gardens","(of) thick foliage"],"t":["waḥadāiqa","ghul'ban"],"p":[1,2],"en":"And gardens of dense shrubbery"},{"a":["وَفَٰكِهَةࣰ","وَأَبࣰّا"],"w":["And fruits","and grass"],"t":["wafākihatan","wa-abban"],"p":[1,2],"en":"And fruit and grass"},{"a":["مَّتَٰعࣰا","لَّكُمۡ","وَلِأَنۡعَٰمِكُمۡ"],"w":["(As) a provision","for you","and for your cattle"],"t":["matāʿan","lakum","wali-anʿāmikum"],"p":[1,2,3],"en":"[As] enjoyment for you and your grazing livestock"},{"a":["فَإِذَا","جَآءَتِ","ٱلصَّآخَّةُ"],"w":["But when","comes","the Deafening Blast"],"t":["fa-idhā","jāati","l-ṣākhatu"],"p":[1,2,3],"en":"But when there comes the Deafening Blast"},{"a":["يَوۡمَ","يَفِرُّ","ٱلۡمَرۡءُ","مِنۡ","أَخِيهِ"],"w":["(The) Day","will flee","a man","from","his brother"],"t":["yawma","yafirru","l-maru","min","akhīhi"],"p":[1,2,3,4,5],"en":"On the Day a man will flee from his brother"},{"a":["وَأُمِّهِۦ","وَأَبِيهِ"],"w":["And his mother","and his father"],"t":["wa-ummihi","wa-abīhi"],"p":[1,2],"en":"And his mother and his father"},{"a":["وَصَٰحِبَتِهِۦ","وَبَنِيهِ"],"w":["And his wife","and his children"],"t":["waṣāḥibatihi","wabanīhi"],"p":[1,2],"en":"And his wife and his children"},{"a":["لِكُلِّ","ٱمۡرِيࣲٕ","مِّنۡهُمۡ","يَوۡمَئِذࣲ","شَأۡنࣱ","يُغۡنِيهِ"],"w":["For every","man","among them","that Day","(will be) a matter","occupying him"],"t":["likulli","im'ri-in","min'hum","yawma-idhin","shanun","yugh'nīhi"],"p":[1,2,3,4,5,6],"en":"For every man, that Day, will be a matter adequate for him"},{"a":["وُجُوهࣱ","يَوۡمَئِذࣲ","مُّسۡفِرَةࣱ"],"w":["Faces","that Day","(will be) bright"],"t":["wujūhun","yawma-idhin","mus'firatun"],"p":[1,2,3],"en":"[Some] faces, that Day, will be bright"},{"a":["ضَاحِكَةࣱ","مُّسۡتَبۡشِرَةࣱ"],"w":["Laughing","rejoicing at good news"],"t":["ḍāḥikatun","mus'tabshiratun"],"p":[1,2],"en":"Laughing, rejoicing at good news"},{"a":["وَوُجُوهࣱ","يَوۡمَئِذٍ","عَلَيۡهَا","غَبَرَةࣱ"],"w":["And faces","that Day","upon them","(will be) dust"],"t":["wawujūhun","yawma-idhin","ʿalayhā","ghabaratun"],"p":[1,2,3,4],"en":"And [other] faces, that Day, will have upon them dust"},{"a":["تَرۡهَقُهَا","قَتَرَةٌ"],"w":["Will cover them","darkness"],"t":["tarhaquhā","qataratun"],"p":[1,2],"en":"Blackness will cover them"},{"a":["أُوْلَـٰٓئِكَ","هُمُ","ٱلۡكَفَرَةُ","ٱلۡفَجَرَةُ"],"w":["Those","[they]","(are) the disbelievers","the wicked ones"],"t":["ulāika","humu","l-kafaratu","l-fajaratu"],"p":[1,2,3,4],"en":"Those are the disbelievers, the wicked ones"}]}