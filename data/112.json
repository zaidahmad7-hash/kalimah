{"n":112,"ar":"الإخلاص","name":"Al-Ikhlas","mean":"The Sincerity","type":"meccan","v":[{"a":["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"w":["Say","He","(is) Allah","the One"],"t":["qul","huwa","l-lahu","aḥadun"],"p":[1,2,3,4],"en":"Say, \"He is Allah, [who is] One"},{"a":["ٱللَّهُ","ٱلصَّمَدُ"],"w":["Allah","the Eternal, the Absolute"],"t":["al-lahu","l-ṣamadu"],"p":[1,2],"en":"Allah, the Eternal Refuge"},{"a":["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"w":["Not","He begets","and not","He is begotten"],"t":["lam","yalid","walam","yūlad"],"p":[1,2,3,4],"en":"He neither begets nor is born"},{"a":["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"w":["And not","is","for Him","equivalent","any [one]"],"t":["walam","yakun","lahu","kufuwan","aḥadun"],"p":[1,2,3,4,5],"en":"Nor is there to Him any equivalent"}]}