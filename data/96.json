{"n":96,"ar":"العلق","name":"Al-'Alaq","mean":"The Clot","type":"meccan","v":[{"a":["ٱقۡرَأۡ","بِٱسۡمِ","رَبِّكَ","ٱلَّذِي","خَلَقَ"],"w":["Read","in (the) name","(of) your Lord","the One Who","created "],"t":["iq'ra","bi-is'mi","rabbika","alladhī","khalaqa"],"p":[1,2,3,4,5],"en":"Recite in the name of your Lord who created"},{"a":["خَلَقَ","ٱلۡإِنسَٰنَ","مِنۡ","عَلَقٍ"],"w":["He created","man","from","a clinging substance"],"t":["khalaqa","l-insāna","min","ʿalaqin"],"p":[1,2,3,4],"en":"Created man from a clinging substance"},{"a":["ٱقۡرَأۡ","وَرَبُّكَ","ٱلۡأَكۡرَمُ"],"w":["Read","and your Lord","(is) the Most Generous"],"t":["iq'ra","warabbuka","l-akramu"],"p":[1,2,3],"en":"Recite, and your Lord is the most Generous"},{"a":["ٱلَّذِي","عَلَّمَ","بِٱلۡقَلَمِ"],"w":["The One Who","taught","by the pen"],"t":["alladhī","ʿallama","bil-qalami"],"p":[1,2,3],"en":"Who taught by the pen"},{"a":["عَلَّمَ","ٱلۡإِنسَٰنَ","مَا","لَمۡ","يَعۡلَمۡ"],"w":["Taught","man","what","not","he knew"],"t":["ʿallama","l-insāna","mā","lam","yaʿlam"],"p":[1,2,3,4,5],"en":"Taught man that which he knew not"},{"a":["كَلَّآ","إِنَّ","ٱلۡإِنسَٰنَ","لَيَطۡغَىٰٓ"],"w":["Nay","Indeed","man","surely transgresses"],"t":["kallā","inna","l-insāna","layaṭghā"],"p":[1,2,3,4],"en":"No! [But] indeed, man transgresses"},{"a":["أَن","رَّءَاهُ","ٱسۡتَغۡنَىٰٓ"],"w":["That","he sees himself","self-sufficient"],"t":["an","raāhu","is'taghnā"],"p":[1,2,3],"en":"Because he sees himself self-sufficient"},{"a":["إِنَّ","إِلَىٰ","رَبِّكَ","ٱلرُّجۡعَىٰٓ"],"w":["Indeed","to","your Lord","(is) the return"],"t":["inna","ilā","rabbika","l-ruj'ʿā"],"p":[1,2,3,4],"en":"Indeed, to your Lord is the return"},{"a":["أَرَءَيۡتَ","ٱلَّذِي","يَنۡهَىٰ"],"w":["Have you seen","the one who","forbids"],"t":["ara-ayta","alladhī","yanhā"],"p":[1,2,3],"en":"Have you seen the one who forbids"},{"a":["عَبۡدًا","إِذَا","صَلَّىٰٓ"],"w":["A slave","when","he prays"],"t":["ʿabdan","idhā","ṣallā"],"p":[1,2,3],"en":"A servant when he prays"},{"a":["أَرَءَيۡتَ","إِن","كَانَ","عَلَى","ٱلۡهُدَىٰٓ"],"w":["Have you seen","if","he is","upon","[the] guidance"],"t":["ara-ayta","in","kāna","ʿalā","l-hudā"],"p":[1,2,3,4,5],"en":"Have you seen if he is upon guidance"},{"a":["أَوۡ","أَمَرَ","بِٱلتَّقۡوَىٰٓ"],"w":["Or","he enjoins","[of the] righteousness"],"t":["aw","amara","bil-taqwā"],"p":[1,2,3],"en":"Or enjoins righteousness"},{"a":["أَرَءَيۡتَ","إِن","كَذَّبَ","وَتَوَلَّىٰٓ"],"w":["Have you seen","if","he denies","and turns away"],"t":["ara-ayta","in","kadhaba","watawallā"],"p":[1,2,3,4],"en":"Have you seen if he denies and turns away"},{"a":["أَلَمۡ","يَعۡلَم","بِأَنَّ","ٱللَّهَ","يَرَىٰ"],"w":["Does not","he know","that","Allah","sees"],"t":["alam","yaʿlam","bi-anna","l-laha","yarā"],"p":[1,2,3,4,5],"en":"Does he not know that Allah sees"},{"a":["كَلَّا","لَئِن","لَّمۡ","يَنتَهِ","لَنَسۡفَعَۢا","بِٱلنَّاصِيَةِ"],"w":["Nay","If","not","he desists","surely We will drag him","by the forelock"],"t":["kallā","la-in","lam","yantahi","lanasfaʿan","bil-nāṣiyati"],"p":[1,2,3,4,5,6],"en":"No! If he does not desist, We will surely drag him by the forelock"},{"a":["نَاصِيَةࣲ","كَٰذِبَةٍ","خَاطِئَةࣲ"],"w":["A forelock","lying","sinful"],"t":["nāṣiyatin","kādhibatin","khāṭi-atin"],"p":[1,2,3],"en":"A lying, sinning forelock"},{"a":["فَلۡيَدۡعُ","نَادِيَهُۥ"],"w":["Then let him call","his associates"],"t":["falyadʿu","nādiyahu"],"p":[1,2],"en":"Then let him call his associates"},{"a":["سَنَدۡعُ","ٱلزَّبَانِيَةَ"],"w":["We will call","the Angels of Hell"],"t":["sanadʿu","l-zabāniyata"],"p":[1,2],"en":"We will call the angels of Hell"},{"a":["كَلَّا","لَا","تُطِعۡهُ","وَٱسۡجُدۡۤ","وَٱقۡتَرِب۩"],"w":["Nay","(Do) not","obey him","But prostrate","and draw near (to Allah)"],"t":["kallā","lā","tuṭiʿ'hu","wa-us'jud","wa-iq'tarib"],"p":[1,2,3,4,5],"en":"No! Do not obey him. But prostrate and draw near [to Allah]"}]}