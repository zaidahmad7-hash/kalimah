{"n":81,"ar":"التكوير","name":"At-Takwir","mean":"The Overthrowing","type":"meccan","v":[{"a":["إِذَا","ٱلشَّمۡسُ","كُوِّرَتۡ"],"w":["When","the sun","is wrapped up"],"t":["idhā","l-shamsu","kuwwirat"],"p":[1,2,3],"en":"When the sun is wrapped up [in darkness]"},{"a":["وَإِذَا","ٱلنُّجُومُ","ٱنكَدَرَتۡ"],"w":["And when","the stars","fall, losing their luster"],"t":["wa-idhā","l-nujūmu","inkadarat"],"p":[1,2,3],"en":"And when the stars fall, dispersing"},{"a":["وَإِذَا","ٱلۡجِبَالُ","سُيِّرَتۡ"],"w":["And when","the mountains","are moved away"],"t":["wa-idhā","l-jibālu","suyyirat"],"p":[1,2,3],"en":"And when the mountains are removed"},{"a":["وَإِذَا","ٱلۡعِشَارُ","عُطِّلَتۡ"],"w":["And when","the full-term she-camels","(are) left untended"],"t":["wa-idhā","l-ʿishāru","ʿuṭṭilat"],"p":[1,2,3],"en":"And when full-term she-camels are neglected"},{"a":["وَإِذَا","ٱلۡوُحُوشُ","حُشِرَتۡ"],"w":["And when","the wild beasts","are gathered"],"t":["wa-idhā","l-wuḥūshu","ḥushirat"],"p":[1,2,3],"en":"And when the wild beasts are gathered"},{"a":["وَإِذَا","ٱلۡبِحَارُ","سُجِّرَتۡ"],"w":["And when","the seas","are made to overflow"],"t":["wa-idhā","l-biḥāru","sujjirat"],"p":[1,2,3],"en":"And when the seas are filled with flame"},{"a":["وَإِذَا","ٱلنُّفُوسُ","زُوِّجَتۡ"],"w":["And when","the souls","are paired"],"t":["wa-idhā","l-nufūsu","zuwwijat"],"p":[1,2,3],"en":"And when the souls are paired"},{"a":["وَإِذَا","ٱلۡمَوۡءُۥدَةُ","سُئِلَتۡ"],"w":["And when","the female infant buried alive","is asked"],"t":["wa-idhā","l-mawūdatu","su-ilat"],"p":[1,2,3],"en":"And when the girl [who was] buried alive is asked"},{"a":["بِأَيِّ","ذَنۢبࣲ","قُتِلَتۡ"],"w":["For what","sin","she was killed"],"t":["bi-ayyi","dhanbin","qutilat"],"p":[1,2,3],"en":"For what sin she was killed"},{"a":["وَإِذَا","ٱلصُّحُفُ","نُشِرَتۡ"],"w":["And when","the pages","are laid open"],"t":["wa-idhā","l-ṣuḥufu","nushirat"],"p":[1,2,3],"en":"And when the pages are made public"},{"a":["وَإِذَا","ٱلسَّمَآءُ","كُشِطَتۡ"],"w":["And when","the sky","is stripped away"],"t":["wa-idhā","l-samāu","kushiṭat"],"p":[1,2,3],"en":"And when the sky is stripped away"},{"a":["وَإِذَا","ٱلۡجَحِيمُ","سُعِّرَتۡ"],"w":["And when","the Hellfire","is set ablaze"],"t":["wa-idhā","l-jaḥīmu","suʿʿirat"],"p":[1,2,3],"en":"And when Hellfire is set ablaze"},{"a":["وَإِذَا","ٱلۡجَنَّةُ","أُزۡلِفَتۡ"],"w":["And when","Paradise","is brought near"],"t":["wa-idhā","l-janatu","uz'lifat"],"p":[1,2,3],"en":"And when Paradise is brought near"},{"a":["عَلِمَتۡ","نَفۡسࣱ","مَّآ","أَحۡضَرَتۡ"],"w":["Will know","a soul","what","it has brought"],"t":["ʿalimat","nafsun","mā","aḥḍarat"],"p":[1,2,3,4],"en":"A soul will [then] know what it has brought [with it]"},{"a":["فَلَآ","أُقۡسِمُ","بِٱلۡخُنَّسِ"],"w":["But nay","I swear","by the retreating planets"],"t":["falā","uq'simu","bil-khunasi"],"p":[1,2,3],"en":"So I swear by the retreating stars"},{"a":["ٱلۡجَوَارِ","ٱلۡكُنَّسِ"],"w":["Those that run","(and) disappear"],"t":["al-jawāri","l-kunasi"],"p":[1,2],"en":"Those that run [their courses] and disappear"},{"a":["وَٱلَّيۡلِ","إِذَا","عَسۡعَسَ"],"w":["And the night","when","it departs"],"t":["wa-al-layli","idhā","ʿasʿasa"],"p":[1,2,3],"en":"And by the night as it closes in"},{"a":["وَٱلصُّبۡحِ","إِذَا","تَنَفَّسَ"],"w":["And the dawn","when","it breathes"],"t":["wal-ṣub'ḥi","idhā","tanaffasa"],"p":[1,2,3],"en":"And by the dawn when it breathes"},{"a":["إِنَّهُۥ","لَقَوۡلُ","رَسُولࣲ","كَرِيمࣲ"],"w":["Indeed, it","(is) surely a word","(of) a Messenger","noble"],"t":["innahu","laqawlu","rasūlin","karīmin"],"p":[1,2,3,4],"en":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger"},{"a":["ذِي","قُوَّةٍ","عِندَ","ذِي","ٱلۡعَرۡشِ","مَكِينࣲ"],"w":["Possessor of","power","with","(the) Owner of","the Throne","secure"],"t":["dhī","quwwatin","ʿinda","dhī","l-ʿarshi","makīnin"],"p":[1,2,3,4,5,6],"en":"[Who is] possessed of power and with the Owner of the Throne, secure [in position]"},{"a":["مُّطَاعࣲ","ثَمَّ","أَمِينࣲ"],"w":["One to be obeyed","and","trustworthy"],"t":["muṭāʿin","thamma","amīnin"],"p":[1,2,3],"en":"Obeyed there [in the heavens] and trustworthy"},{"a":["وَمَا","صَاحِبُكُم","بِمَجۡنُونࣲ"],"w":["And not","(is) your companion","mad"],"t":["wamā","ṣāḥibukum","bimajnūnin"],"p":[1,2,3],"en":"And your companion is not [at all] mad"},{"a":["وَلَقَدۡ","رَءَاهُ","بِٱلۡأُفُقِ","ٱلۡمُبِينِ"],"w":["And certainly","he saw him","in the horizon","the clear"],"t":["walaqad","raāhu","bil-ufuqi","l-mubīni"],"p":[1,2,3,4],"en":"And he has already seen Gabriel in the clear horizon"},{"a":["وَمَا","هُوَ","عَلَى","ٱلۡغَيۡبِ","بِضَنِينࣲ"],"w":["And not","he (is)","on","the unseen","a withholder"],"t":["wamā","huwa","ʿalā","l-ghaybi","biḍanīnin"],"p":[1,2,3,4,5],"en":"And Muhammad is not a withholder of [knowledge of] the unseen"},{"a":["وَمَا","هُوَ","بِقَوۡلِ","شَيۡطَٰنࣲ","رَّجِيمࣲ"],"w":["And not","it","(is the) word","(of) Shaitaan","accursed"],"t":["wamā","huwa","biqawli","shayṭānin","rajīmin"],"p":[1,2,3,4,5],"en":"And the Qur'an is not the word of a devil, expelled [from the heavens]"},{"a":["فَأَيۡنَ","تَذۡهَبُونَ"],"w":["So where","are you going"],"t":["fa-ayna","tadhhabūna"],"p":[1,2],"en":"So where are you going"},{"a":["إِنۡ","هُوَ","إِلَّا","ذِكۡرࣱ","لِّلۡعَٰلَمِينَ"],"w":["Not","it","(is) except","a reminder","to the worlds"],"t":["in","huwa","illā","dhik'run","lil'ʿālamīna"],"p":[1,2,3,4,5],"en":"It is not except a reminder to the worlds"},{"a":["لِمَن","شَآءَ","مِنكُمۡ","أَن","يَسۡتَقِيمَ"],"w":["For whoever","wills","among you","to","take a straight way"],"t":["liman","shāa","minkum","an","yastaqīma"],"p":[1,2,3,4,5],"en":"For whoever wills among you to take a right course"},{"a":["وَمَا","تَشَآءُونَ","إِلَّآ","أَن","يَشَآءَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"w":["And not","you will","except","that","wills","Allah","Lord","(of) the worlds"],"t":["wamā","tashāūna","illā","an","yashāa","l-lahu","rabbu","l-ʿālamīna"],"p":[1,2,3,4,5,6,7,8],"en":"And you do not will except that Allah wills - Lord of the worlds"}]}