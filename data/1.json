{"n":1,"ar":"الفاتحة","name":"Al-Fatihah","mean":"The Opener","type":"meccan","v":[{"a":["بِسۡمِ","ٱللَّهِ","ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"w":["In (the) name","(of) Allah","the Most Gracious","the Most Merciful"],"t":["bis'mi","l-lahi","l-raḥmāni","l-raḥīmi"],"p":[1,2,3,4],"en":"In the name of Allah, the Entirely Merciful, the Especially Merciful"},{"a":["ٱلۡحَمۡدُ","لِلَّهِ","رَبِّ","ٱلۡعَٰلَمِينَ"],"w":["All praises and thanks","(be) to Allah","the Lord","of the universe"],"t":["al-ḥamdu","lillahi","rabbi","l-ʿālamīna"],"p":[1,2,3,4],"en":"[All] praise is [due] to Allah, Lord of the worlds"},{"a":["ٱلرَّحۡمَٰنِ","ٱلرَّحِيمِ"],"w":["The Most Gracious","the Most Merciful"],"t":["al-raḥmāni","l-raḥīmi"],"p":[1,2],"en":"The Entirely Merciful, the Especially Merciful"},{"a":["مَٰلِكِ","يَوۡمِ","ٱلدِّينِ"],"w":["(The) Master","(of the) Day","(of the) Judgment"],"t":["māliki","yawmi","l-dīni"],"p":[1,2,3],"en":"Sovereign of the Day of Recompense"},{"a":["إِيَّاكَ","نَعۡبُدُ","وَإِيَّاكَ","نَسۡتَعِينُ"],"w":["You Alone","we worship","and You Alone","we ask for help"],"t":["iyyāka","naʿbudu","wa-iyyāka","nastaʿīnu"],"p":[1,2,3,4],"en":"It is You we worship and You we ask for help"},{"a":["ٱهۡدِنَا","ٱلصِّرَٰطَ","ٱلۡمُسۡتَقِيمَ"],"w":["Guide us","(to) the path","the straight"],"t":["ih'dinā","l-ṣirāṭa","l-mus'taqīma"],"p":[1,2,3],"en":"Guide us to the straight path"},{"a":["صِرَٰطَ","ٱلَّذِينَ","أَنۡعَمۡتَ","عَلَيۡهِمۡ","غَيۡرِ","ٱلۡمَغۡضُوبِ","عَلَيۡهِمۡ","وَلَا","ٱلضَّآلِّينَ"],"w":["(The) path","(of) those","You have bestowed (Your) Favors","on them","not (of)","those who earned (Your) wrath","on themselves","and not","(of) those who go astray"],"t":["ṣirāṭa","alladhīna","anʿamta","ʿalayhim","ghayri","l-maghḍūbi","ʿalayhim","walā","l-ḍālīna"],"p":[1,2,3,4,5,6,7,8,9],"en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray"}]}