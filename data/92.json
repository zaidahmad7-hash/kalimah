{"n":92,"ar":"الليل","name":"Al-Layl","mean":"The Night","type":"meccan","v":[{"a":["وَٱلَّيۡلِ","إِذَا","يَغۡشَىٰ"],"w":["By the night","when","it covers"],"t":["wa-al-layli","idhā","yaghshā"],"p":[1,2,3],"en":"By the night when it covers"},{"a":["وَٱلنَّهَارِ","إِذَا","تَجَلَّىٰ"],"w":["And the day","when","it shines in brightness"],"t":["wal-nahāri","idhā","tajallā"],"p":[1,2,3],"en":"And [by] the day when it appears"},{"a":["وَمَا","خَلَقَ","ٱلذَّكَرَ","وَٱلۡأُنثَىٰٓ"],"w":["And He Who","created","the male","and the female"],"t":["wamā","khalaqa","l-dhakara","wal-unthā"],"p":[1,2,3,4],"en":"And [by] He who created the male and female"},{"a":["إِنَّ","سَعۡيَكُمۡ","لَشَتَّىٰ"],"w":["Indeed","your efforts","(are) surely diverse"],"t":["inna","saʿyakum","lashattā"],"p":[1,2,3],"en":"Indeed, your efforts are diverse"},{"a":["فَأَمَّا","مَنۡ","أَعۡطَىٰ","وَٱتَّقَىٰ"],"w":["Then as for","(him) who","gives","and fears"],"t":["fa-ammā","man","aʿṭā","wa-ittaqā"],"p":[1,2,3,4],"en":"As for he who gives and fears Allah"},{"a":["وَصَدَّقَ","بِٱلۡحُسۡنَىٰ"],"w":["And believes","in the best"],"t":["waṣaddaqa","bil-ḥus'nā"],"p":[1,2],"en":"And believes in the best [reward]"},{"a":["فَسَنُيَسِّرُهُۥ","لِلۡيُسۡرَىٰ"],"w":["Then We will ease him","towards [the] ease"],"t":["fasanuyassiruhu","lil'yus'rā"],"p":[1,2],"en":"We will ease him toward ease"},{"a":["وَأَمَّا","مَنۢ","بَخِلَ","وَٱسۡتَغۡنَىٰ"],"w":["But as for","(him) who","withholds","and considers himself free from need"],"t":["wa-ammā","man","bakhila","wa-is'taghnā"],"p":[1,2,3,4],"en":"But as for he who withholds and considers himself free of need"},{"a":["وَكَذَّبَ","بِٱلۡحُسۡنَىٰ"],"w":["And denies","the best"],"t":["wakadhaba","bil-ḥus'nā"],"p":[1,2],"en":"And denies the best [reward]"},{"a":["فَسَنُيَسِّرُهُۥ","لِلۡعُسۡرَىٰ"],"w":["Then We will ease him","towards [the] difficulty"],"t":["fasanuyassiruhu","lil'ʿus'rā"],"p":[1,2],"en":"We will ease him toward difficulty"},{"a":["وَمَا","يُغۡنِي","عَنۡهُ","مَالُهُۥٓ","إِذَا","تَرَدَّىٰٓ"],"w":["And not","will avail","him","his wealth","when","he falls"],"t":["wamā","yugh'nī","ʿanhu","māluhu","idhā","taraddā"],"p":[1,2,3,4,5,6],"en":"And what will his wealth avail him when he falls"},{"a":["إِنَّ","عَلَيۡنَا","لَلۡهُدَىٰ"],"w":["Indeed","upon Us","(is) the guidance"],"t":["inna","ʿalaynā","lalhudā"],"p":[1,2,3],"en":"Indeed, [incumbent] upon Us is guidance"},{"a":["وَإِنَّ","لَنَا","لَلۡأٓخِرَةَ","وَٱلۡأُولَىٰ"],"w":["And indeed","for Us","(is) the Hereafter","and the first (life)"],"t":["wa-inna","lanā","lalākhirata","wal-ūlā"],"p":[1,2,3,4],"en":"And indeed, to Us belongs the Hereafter and the first [life]"},{"a":["فَأَنذَرۡتُكُمۡ","نَارࣰا","تَلَظَّىٰ"],"w":["So I warn you","(of) a Fire","blazing"],"t":["fa-andhartukum","nāran","talaẓẓā"],"p":[1,2,3],"en":"So I have warned you of a Fire which is blazing"},{"a":["لَا","يَصۡلَىٰهَآ","إِلَّا","ٱلۡأَشۡقَى"],"w":["Not","will burn (in) it","except","the most wretched"],"t":["lā","yaṣlāhā","illā","l-ashqā"],"p":[1,2,3,4],"en":"None will [enter to] burn therein except the most wretched one"},{"a":["ٱلَّذِي","كَذَّبَ","وَتَوَلَّىٰ"],"w":["The one who","denied","and turned away"],"t":["alladhī","kadhaba","watawallā"],"p":[1,2,3],"en":"Who had denied and turned away"},{"a":["وَسَيُجَنَّبُهَا","ٱلۡأَتۡقَى"],"w":["But will be removed from it","the righteous"],"t":["wasayujannabuhā","l-atqā"],"p":[1,2],"en":"But the righteous one will avoid it"},{"a":["ٱلَّذِي","يُؤۡتِي","مَالَهُۥ","يَتَزَكَّىٰ"],"w":["The one who","gives","his wealth","(to) purify himself"],"t":["alladhī","yu'tī","mālahu","yatazakkā"],"p":[1,2,3,4],"en":"[He] who gives [from] his wealth to purify himself"},{"a":["وَمَا","لِأَحَدٍ","عِندَهُۥ","مِن","نِّعۡمَةࣲ","تُجۡزَىٰٓ"],"w":["And not","for anyone","with him","any","favor","to be recompensed"],"t":["wamā","li-aḥadin","ʿindahu","min","niʿ'matin","tuj'zā"],"p":[1,2,3,4,5,6],"en":"And not [giving] for anyone who has [done him] a favor to be rewarded"},{"a":["إِلَّا","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِ","ٱلۡأَعۡلَىٰ"],"w":["Except","seeking","(the) Countenance","(of) his Lord","the Most High"],"t":["illā","ib'tighāa","wajhi","rabbihi","l-aʿlā"],"p":[1,2,3,4,5],"en":"But only seeking the countenance of his Lord, Most High"},{"a":["وَلَسَوۡفَ","يَرۡضَىٰ"],"w":["And soon, surely","he will be pleased"],"t":["walasawfa","yarḍā"],"p":[1,2],"en":"And he is going to be satisfied"}]}