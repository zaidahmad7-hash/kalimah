{"n":111,"ar":"المسد","name":"Al-Masad","mean":"The Palm Fiber","type":"meccan","v":[{"a":["تَبَّتۡ","يَدَآ","أَبِي","لَهَبࣲ","وَتَبَّ"],"w":["Perish","(the) hands","(of) Abu","Lahab","and perish he"],"t":["tabbat","yadā","abī","lahabin","watabba"],"p":[1,2,3,4,5],"en":"May the hands of Abu Lahab be ruined, and ruined is he"},{"a":["مَآ","أَغۡنَىٰ","عَنۡهُ","مَالُهُۥ","وَمَا","كَسَبَ"],"w":["Not","(will) avail","him","his wealth","and what","he earned"],"t":["mā","aghnā","ʿanhu","māluhu","wamā","kasaba"],"p":[1,2,3,4,5,6],"en":"His wealth will not avail him or that which he gained"},{"a":["سَيَصۡلَىٰ","نَارࣰا","ذَاتَ","لَهَبࣲ"],"w":["He will be burnt","(in) a Fire","of","Blazing Flames"],"t":["sayaṣlā","nāran","dhāta","lahabin"],"p":[1,2,3,4],"en":"He will [enter to] burn in a Fire of [blazing] flame"},{"a":["وَٱمۡرَأَتُهُۥ","حَمَّالَةَ","ٱلۡحَطَبِ"],"w":["And his wife","(the) carrier","(of) firewood"],"t":["wa-im'ra-atuhu","ḥammālata","l-ḥaṭabi"],"p":[1,2,3],"en":"And his wife [as well] - the carrier of firewood"},{"a":["فِي","جِيدِهَا","حَبۡلࣱ","مِّن","مَّسَدِۭ"],"w":["In","her neck","(will be) a rope","of","palm-fiber"],"t":["fī","jīdihā","ḥablun","min","masadin"],"p":[1,2,3,4,5],"en":"Around her neck is a rope of [twisted] fiber"}]}