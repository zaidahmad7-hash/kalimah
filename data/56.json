{"n":56,"ar":"الواقعة","name":"Al-Waqi'ah","mean":"The Inevitable","type":"meccan","v":[{"a":["إِذَا","وَقَعَتِ","ٱلۡوَاقِعَةُ"],"w":["When","occurs","the Event"],"t":["idhā","waqaʿati","l-wāqiʿatu"],"p":[1,2,3],"en":"When the Occurrence occurs"},{"a":["لَيۡسَ","لِوَقۡعَتِهَا","كَاذِبَةٌ"],"w":["Not","at its occurrence","a denial"],"t":["laysa","liwaqʿatihā","kādhibatun"],"p":[1,2,3],"en":"There is, at its occurrence, no denial"},{"a":["خَافِضَةࣱ","رَّافِعَةٌ"],"w":["Bringing down","raising up"],"t":["khāfiḍatun","rāfiʿatun"],"p":[1,2],"en":"It will bring down [some] and raise up [others]"},{"a":["إِذَا","رُجَّتِ","ٱلۡأَرۡضُ","رَجࣰّا"],"w":["When","will be shaken","the earth","(with) a shaking"],"t":["idhā","rujjati","l-arḍu","rajjan"],"p":[1,2,3,4],"en":"When the earth is shaken with convulsion"},{"a":["وَبُسَّتِ","ٱلۡجِبَالُ","بَسࣰّا"],"w":["And will be crumbled","the mountains","(with awful) crumbling"],"t":["wabussati","l-jibālu","bassan"],"p":[1,2,3],"en":"And the mountains are broken down, crumbling"},{"a":["فَكَانَتۡ","هَبَآءࣰ","مُّنۢبَثࣰّا"],"w":["So they become","dust particles","dispersing"],"t":["fakānat","habāan","munbathan"],"p":[1,2,3],"en":"And become dust dispersing"},{"a":["وَكُنتُمۡ","أَزۡوَٰجࣰا","ثَلَٰثَةࣰ"],"w":["And you will become","kinds","three"],"t":["wakuntum","azwājan","thalāthatan"],"p":[1,2,3],"en":"And you become [of] three kinds"},{"a":["فَأَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَيۡمَنَةِ"],"w":["Then (the) companions","(of) the right","what","(are the) companions","(of) the right"],"t":["fa-aṣḥābu","l-maymanati","mā","aṣḥābu","l-maymanati"],"p":[1,2,3,4,5],"en":"Then the companions of the right - what are the companions of the right"},{"a":["وَأَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ","مَآ","أَصۡحَٰبُ","ٱلۡمَشۡـَٔمَةِ"],"w":["And (the) companions","(of) the left","what","(are the) companions","(of) the left"],"t":["wa-aṣḥābu","l-mashamati","mā","aṣḥābu","l-mashamati"],"p":[1,2,3,4,5],"en":"And the companions of the left - what are the companions of the left"},{"a":["وَٱلسَّـٰبِقُونَ","ٱلسَّـٰبِقُونَ"],"w":["And the foremost","(are) the foremost"],"t":["wal-sābiqūna","l-sābiqūna"],"p":[1,2],"en":"And the forerunners, the forerunners"},{"a":["أُوْلَـٰٓئِكَ","ٱلۡمُقَرَّبُونَ"],"w":["Those","(are) the nearest ones"],"t":["ulāika","l-muqarabūna"],"p":[1,2],"en":"Those are the ones brought near [to Allah]"},{"a":["فِي","جَنَّـٰتِ","ٱلنَّعِيمِ"],"w":["In","Gardens","(of) Pleasure"],"t":["fī","jannāti","l-naʿīmi"],"p":[1,2,3],"en":"In the Gardens of Pleasure"},{"a":["ثُلَّةࣱ","مِّنَ","ٱلۡأَوَّلِينَ"],"w":["A company","of","the former (people)"],"t":["thullatun","mina","l-awalīna"],"p":[1,2,3],"en":"A [large] company of the former peoples"},{"a":["وَقَلِيلࣱ","مِّنَ","ٱلۡأٓخِرِينَ"],"w":["And a few","of","the later (people)"],"t":["waqalīlun","mina","l-ākhirīna"],"p":[1,2,3],"en":"And a few of the later peoples"},{"a":["عَلَىٰ","سُرُرࣲ","مَّوۡضُونَةࣲ"],"w":["On","thrones","decorated"],"t":["ʿalā","sururin","mawḍūnatin"],"p":[1,2,3],"en":"On thrones woven [with ornament]"},{"a":["مُّتَّكِـِٔينَ","عَلَيۡهَا","مُتَقَٰبِلِينَ"],"w":["Reclining","on them","facing each other"],"t":["muttakiīna","ʿalayhā","mutaqābilīna"],"p":[1,2,3],"en":"Reclining on them, facing each other"},{"a":["يَطُوفُ","عَلَيۡهِمۡ","وِلۡدَٰنࣱ","مُّخَلَّدُونَ"],"w":["Will circulate","among them","boys","immortal"],"t":["yaṭūfu","ʿalayhim","wil'dānun","mukhalladūna"],"p":[1,2,3,4],"en":"There will circulate among them young boys made eternal"},{"a":["بِأَكۡوَابࣲ","وَأَبَارِيقَ","وَكَأۡسࣲ","مِّن","مَّعِينࣲ"],"w":["With vessels","and jugs","and a cup","from","a flowing stream"],"t":["bi-akwābin","wa-abārīqa","wakasin","min","maʿīnin"],"p":[1,2,3,4,5],"en":"With vessels, pitchers and a cup [of wine] from a flowing spring"},{"a":["لَّا","يُصَدَّعُونَ","عَنۡهَا","وَلَا","يُنزِفُونَ"],"w":["Not","they will get headache","therefrom","and not","they will get intoxicated"],"t":["lā","yuṣaddaʿūna","ʿanhā","walā","yunzifūna"],"p":[1,2,3,4,5],"en":"No headache will they have therefrom, nor will they be intoxicated"},{"a":["وَفَٰكِهَةࣲ","مِّمَّا","يَتَخَيَّرُونَ"],"w":["And fruits","of what","they select"],"t":["wafākihatin","mimmā","yatakhayyarūna"],"p":[1,2,3],"en":"And fruit of what they select"},{"a":["وَلَحۡمِ","طَيۡرࣲ","مِّمَّا","يَشۡتَهُونَ"],"w":["And (the) flesh","(of) fowls","of what","they desire"],"t":["walaḥmi","ṭayrin","mimmā","yashtahūna"],"p":[1,2,3,4],"en":"And the meat of fowl, from whatever they desire"},{"a":["وَحُورٌ","عِينࣱ"],"w":["And fair ones","(with) large eyes"],"t":["waḥūrun","ʿīnun"],"p":[1,2],"en":"And [for them are] fair women with large, [beautiful] eyes"},{"a":["كَأَمۡثَٰلِ","ٱللُّؤۡلُوِٕ","ٱلۡمَكۡنُونِ"],"w":["Like","pearls","well-protected"],"t":["ka-amthāli","l-lu'lu-i","l-maknūni"],"p":[1,2,3],"en":"The likenesses of pearls well-protected"},{"a":["جَزَآءَۢ","بِمَا","كَانُواْ","يَعۡمَلُونَ"],"w":["A reward","for what","they used (to)","do"],"t":["jazāan","bimā","kānū","yaʿmalūna"],"p":[1,2,3,4],"en":"As reward for what they used to do"},{"a":["لَا","يَسۡمَعُونَ","فِيهَا","لَغۡوࣰا","وَلَا","تَأۡثِيمًا"],"w":["Not","they will hear","therein","vain talk","and not","sinful (speech)"],"t":["lā","yasmaʿūna","fīhā","laghwan","walā","tathīman"],"p":[1,2,3,4,5,6],"en":"They will not hear therein ill speech or commission of sin"},{"a":["إِلَّا","قِيلࣰا","سَلَٰمࣰا","سَلَٰمࣰا"],"w":["Except","a saying","Peace","Peace"],"t":["illā","qīlan","salāman","salāman"],"p":[1,2,3,4],"en":"Only a saying: \"Peace, peace"},{"a":["وَأَصۡحَٰبُ","ٱلۡيَمِينِ","مَآ","أَصۡحَٰبُ","ٱلۡيَمِينِ"],"w":["And (the) companions","(of) the right","what","(are the) companions","(of) the right"],"t":["wa-aṣḥābu","l-yamīni","mā","aṣḥābu","l-yamīni"],"p":[1,2,3,4,5],"en":"The companions of the right - what are the companions of the right"},{"a":["فِي","سِدۡرࣲ","مَّخۡضُودࣲ"],"w":["Among","lote trees","thornless"],"t":["fī","sid'rin","makhḍūdin"],"p":[1,2,3],"en":"[They will be] among lote trees with thorns removed"},{"a":["وَطَلۡحࣲ","مَّنضُودࣲ"],"w":["And banana trees","layered"],"t":["waṭalḥin","manḍūdin"],"p":[1,2],"en":"And [banana] trees layered [with fruit]"},{"a":["وَظِلࣲّ","مَّمۡدُودࣲ"],"w":["And shade","extended"],"t":["waẓillin","mamdūdin"],"p":[1,2],"en":"And shade extended"},{"a":["وَمَآءࣲ","مَّسۡكُوبࣲ"],"w":["And water","poured forth"],"t":["wamāin","maskūbin"],"p":[1,2],"en":"And water poured out"},{"a":["وَفَٰكِهَةࣲ","كَثِيرَةࣲ"],"w":["And fruit","abundant"],"t":["wafākihatin","kathīratin"],"p":[1,2],"en":"And fruit, abundant [and varied]"},{"a":["لَّا","مَقۡطُوعَةࣲ","وَلَا","مَمۡنُوعَةࣲ"],"w":["Not","limited","and not","forbidden"],"t":["lā","maqṭūʿatin","walā","mamnūʿatin"],"p":[1,2,3,4],"en":"Neither limited [to season] nor forbidden"},{"a":["وَفُرُشࣲ","مَّرۡفُوعَةٍ"],"w":["And (on) couches","raised"],"t":["wafurushin","marfūʿatin"],"p":[1,2],"en":"And [upon] beds raised high"},{"a":["إِنَّآ","أَنشَأۡنَٰهُنَّ","إِنشَآءࣰ"],"w":["Indeed, We","[We] have produced them","(into) a creation"],"t":["innā","anshanāhunna","inshāan"],"p":[1,2,3],"en":"Indeed, We have produced the women of Paradise in a [new] creation"},{"a":["فَجَعَلۡنَٰهُنَّ","أَبۡكَارًا"],"w":["And We have made them","virgins"],"t":["fajaʿalnāhunna","abkāran"],"p":[1,2],"en":"And made them virgins"},{"a":["عُرُبًا","أَتۡرَابࣰا"],"w":["Devoted","equals in age"],"t":["ʿuruban","atrāban"],"p":[1,2],"en":"Devoted [to their husbands] and of equal age"},{"a":["لِّأَصۡحَٰبِ","ٱلۡيَمِينِ"],"w":["For (the) companions","(of) the right"],"t":["li-aṣḥābi","l-yamīni"],"p":[1,2],"en":"For the companions of the right [who are]"},{"a":["ثُلَّةࣱ","مِّنَ","ٱلۡأَوَّلِينَ"],"w":["A company","of","the former people"],"t":["thullatun","mina","l-awalīna"],"p":[1,2,3],"en":"A company of the former peoples"},{"a":["وَثُلَّةࣱ","مِّنَ","ٱلۡأٓخِرِينَ"],"w":["And a company","of","the later people"],"t":["wathullatun","mina","l-ākhirīna"],"p":[1,2,3],"en":"And a company of the later peoples"},{"a":["وَأَصۡحَٰبُ","ٱلشِّمَالِ","مَآ","أَصۡحَٰبُ","ٱلشِّمَالِ"],"w":["And (the) companions","(of) the left","what","(are the) companions","(of) the left"],"t":["wa-aṣḥābu","l-shimāli","mā","aṣḥābu","l-shimāli"],"p":[1,2,3,4,5],"en":"And the companions of the left - what are the companions of the left"},{"a":["فِي","سَمُومࣲ","وَحَمِيمࣲ"],"w":["In","scorching fire","and scalding water"],"t":["fī","samūmin","waḥamīmin"],"p":[1,2,3],"en":"[They will be] in scorching fire and scalding water"},{"a":["وَظِلࣲّ","مِّن","يَحۡمُومࣲ"],"w":["And a shade","of","black smoke"],"t":["waẓillin","min","yaḥmūmin"],"p":[1,2,3],"en":"And a shade of black smoke"},{"a":["لَّا","بَارِدࣲ","وَلَا","كَرِيمٍ"],"w":["Not","cool","and not","pleasant"],"t":["lā","bāridin","walā","karīmin"],"p":[1,2,3,4],"en":"Neither cool nor beneficial"},{"a":["إِنَّهُمۡ","كَانُواْ","قَبۡلَ","ذَٰلِكَ","مُتۡرَفِينَ"],"w":["Indeed, they","were","before","that","indulging in affluence"],"t":["innahum","kānū","qabla","dhālika","mut'rafīna"],"p":[1,2,3,4,5],"en":"Indeed they were, before that, indulging in affluence"},{"a":["وَكَانُواْ","يُصِرُّونَ","عَلَى","ٱلۡحِنثِ","ٱلۡعَظِيمِ"],"w":["And were","persisting","in","the sin","the great"],"t":["wakānū","yuṣirrūna","ʿalā","l-ḥinthi","l-ʿaẓīmi"],"p":[1,2,3,4,5],"en":"And they used to persist in the great violation"},{"a":["وَكَانُواْ","يَقُولُونَ","أَئِذَا","مِتۡنَا","وَكُنَّا","تُرَابࣰا","وَعِظَٰمًا","أَءِنَّا","لَمَبۡعُوثُونَ"],"w":["And they used (to)","say","When","we die","and become","dust","and bones","will we","surely be resurrected"],"t":["wakānū","yaqūlūna","a-idhā","mit'nā","wakunnā","turāban","waʿiẓāman","a-innā","lamabʿūthūna"],"p":[1,2,3,4,5,6,7,8,9],"en":"And they used to say, \"When we die and become dust and bones, are we indeed to be resurrected"},{"a":["أَوَءَابَآؤُنَا","ٱلۡأَوَّلُونَ"],"w":["And also our fathers","former"],"t":["awaābāunā","l-awalūna"],"p":[1,2],"en":"And our forefathers [as well]"},{"a":["قُلۡ","إِنَّ","ٱلۡأَوَّلِينَ","وَٱلۡأٓخِرِينَ"],"w":["Say","Indeed","the former","and the later people"],"t":["qul","inna","l-awalīna","wal-ākhirīna"],"p":[1,2,3,4],"en":"Say, [O Muhammad], \"Indeed, the former and the later peoples"},{"a":["لَمَجۡمُوعُونَ","إِلَىٰ","مِيقَٰتِ","يَوۡمࣲ","مَّعۡلُومࣲ"],"w":["Surely, will be gathered","for","(the) appointment","(of) a Day","well-known"],"t":["lamajmūʿūna","ilā","mīqāti","yawmin","maʿlūmin"],"p":[1,2,3,4,5],"en":"Are to be gathered together for the appointment of a known Day"},{"a":["ثُمَّ","إِنَّكُمۡ","أَيُّهَا","ٱلضَّآلُّونَ","ٱلۡمُكَذِّبُونَ"],"w":["Then","indeed you","O those astray","O those astray","the deniers"],"t":["thumma","innakum","ayyuhā","l-ḍālūna","l-mukadhibūna"],"p":[1,2,3,4,5],"en":"Then indeed you, O those astray [who are] deniers"},{"a":["لَأٓكِلُونَ","مِن","شَجَرࣲ","مِّن","زَقُّومࣲ"],"w":["Will surely eat","from","(the) tree","of","Zaqqum"],"t":["laākilūna","min","shajarin","min","zaqqūmin"],"p":[1,2,3,4,5],"en":"Will be eating from trees of zaqqum"},{"a":["فَمَالِـُٔونَ","مِنۡهَا","ٱلۡبُطُونَ"],"w":["Then will fill","with it","the bellies"],"t":["famāliūna","min'hā","l-buṭūna"],"p":[1,2,3],"en":"And filling with it your bellies"},{"a":["فَشَٰرِبُونَ","عَلَيۡهِ","مِنَ","ٱلۡحَمِيمِ"],"w":["And drink","over it","[from]","the scalding water"],"t":["fashāribūna","ʿalayhi","mina","l-ḥamīmi"],"p":[1,2,3,4],"en":"And drinking on top of it from scalding water"},{"a":["فَشَٰرِبُونَ","شُرۡبَ","ٱلۡهِيمِ"],"w":["And will drink","(as) drinking","(of) the thirsty camels"],"t":["fashāribūna","shur'ba","l-hīmi"],"p":[1,2,3],"en":"And will drink as the drinking of thirsty camels"},{"a":["هَٰذَا","نُزُلُهُمۡ","يَوۡمَ","ٱلدِّينِ"],"w":["This","(is) their hospitality","(on the) Day","(of) Judgment"],"t":["hādhā","nuzuluhum","yawma","l-dīni"],"p":[1,2,3,4],"en":"That is their accommodation on the Day of Recompense"},{"a":["نَحۡنُ","خَلَقۡنَٰكُمۡ","فَلَوۡلَا","تُصَدِّقُونَ"],"w":["We","[We] created you","so why (do) not","you admit the truth"],"t":["naḥnu","khalaqnākum","falawlā","tuṣaddiqūna"],"p":[1,2,3,4],"en":"We have created you, so why do you not believe"},{"a":["أَفَرَءَيۡتُم","مَّا","تُمۡنُونَ"],"w":["Do you see","what","you emit"],"t":["afara-aytum","mā","tum'nūna"],"p":[1,2,3],"en":"Have you seen that which you emit"},{"a":["ءَأَنتُمۡ","تَخۡلُقُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلۡخَٰلِقُونَ"],"w":["Is it you","who create it","or","(are) We","the Creators"],"t":["a-antum","takhluqūnahu","am","naḥnu","l-khāliqūna"],"p":[1,2,3,4,5],"en":"Is it you who creates it, or are We the Creator"},{"a":["نَحۡنُ","قَدَّرۡنَا","بَيۡنَكُمُ","ٱلۡمَوۡتَ","وَمَا","نَحۡنُ","بِمَسۡبُوقِينَ"],"w":["We","[We] have decreed","among you","the death","and not","We","(are) outrun"],"t":["naḥnu","qaddarnā","baynakumu","l-mawta","wamā","naḥnu","bimasbūqīna"],"p":[1,2,3,4,5,6,7],"en":"We have decreed death among you, and We are not to be outdone"},{"a":["عَلَىٰٓ","أَن","نُّبَدِّلَ","أَمۡثَٰلَكُمۡ","وَنُنشِئَكُمۡ","فِي","مَا","لَا","تَعۡلَمُونَ"],"w":["In","that","We (will) change","your likeness[es]","and produce you","in","what","not","you know"],"t":["ʿalā","an","nubaddila","amthālakum","wanunshi-akum","fī","mā","lā","taʿlamūna"],"p":[1,2,3,4,5,6,7,8,9],"en":"In that We will change your likenesses and produce you in that [form] which you do not know"},{"a":["وَلَقَدۡ","عَلِمۡتُمُ","ٱلنَّشۡأَةَ","ٱلۡأُولَىٰ","فَلَوۡلَا","تَذَكَّرُونَ"],"w":["And certainly","you know","the creation","the first","so why not","you take heed"],"t":["walaqad","ʿalim'tumu","l-nashata","l-ūlā","falawlā","tadhakkarūna"],"p":[1,2,3,4,5,6],"en":"And you have already known the first creation, so will you not remember"},{"a":["أَفَرَءَيۡتُم","مَّا","تَحۡرُثُونَ"],"w":["And do you see","what","you sow"],"t":["afara-aytum","mā","taḥruthūna"],"p":[1,2,3],"en":"And have you seen that [seed] which you sow"},{"a":["ءَأَنتُمۡ","تَزۡرَعُونَهُۥٓ","أَمۡ","نَحۡنُ","ٱلزَّـٰرِعُونَ"],"w":["Is it you (who)","cause it to grow","or","(are) We","the Ones Who grow"],"t":["a-antum","tazraʿūnahu","am","naḥnu","l-zāriʿūna"],"p":[1,2,3,4,5],"en":"Is it you who makes it grow, or are We the grower"},{"a":["لَوۡ","نَشَآءُ","لَجَعَلۡنَٰهُ","حُطَٰمࣰا","فَظَلۡتُمۡ","تَفَكَّهُونَ"],"w":["If","We willed","We (would) surely, make it","debris","then you would remain","wondering"],"t":["law","nashāu","lajaʿalnāhu","ḥuṭāman","faẓaltum","tafakkahūna"],"p":[1,2,3,4,5,6],"en":"If We willed, We could make it [dry] debris, and you would remain in wonder"},{"a":["إِنَّا","لَمُغۡرَمُونَ"],"w":["Indeed, we","surely are laden with debt"],"t":["innā","lamugh'ramūna"],"p":[1,2],"en":"[Saying], \"Indeed, we are [now] in debt"},{"a":["بَلۡ","نَحۡنُ","مَحۡرُومُونَ"],"w":["Nay","we","(are) deprived"],"t":["bal","naḥnu","maḥrūmūna"],"p":[1,2,3],"en":"Rather, we have been deprived"},{"a":["أَفَرَءَيۡتُمُ","ٱلۡمَآءَ","ٱلَّذِي","تَشۡرَبُونَ"],"w":["Do you see","the water","which","you drink"],"t":["afara-aytumu","l-māa","alladhī","tashrabūna"],"p":[1,2,3,4],"en":"And have you seen the water that you drink"},{"a":["ءَأَنتُمۡ","أَنزَلۡتُمُوهُ","مِنَ","ٱلۡمُزۡنِ","أَمۡ","نَحۡنُ","ٱلۡمُنزِلُونَ"],"w":["Is it you","who send it down","from","the rain clouds","or","We","(are) the Ones to send"],"t":["a-antum","anzaltumūhu","mina","l-muz'ni","am","naḥnu","l-munzilūna"],"p":[1,2,3,4,5,6,7],"en":"Is it you who brought it down from the clouds, or is it We who bring it down"},{"a":["لَوۡ","نَشَآءُ","جَعَلۡنَٰهُ","أُجَاجࣰا","فَلَوۡلَا","تَشۡكُرُونَ"],"w":["If","We willed","We (could) make it","salty","then why are you not grateful","then why are you not grateful"],"t":["law","nashāu","jaʿalnāhu","ujājan","falawlā","tashkurūna"],"p":[1,2,3,4,5,6],"en":"If We willed, We could make it bitter, so why are you not grateful"},{"a":["أَفَرَءَيۡتُمُ","ٱلنَّارَ","ٱلَّتِي","تُورُونَ"],"w":["Do you see","the Fire","which","you ignite"],"t":["afara-aytumu","l-nāra","allatī","tūrūna"],"p":[1,2,3,4],"en":"And have you seen the fire that you ignite"},{"a":["ءَأَنتُمۡ","أَنشَأۡتُمۡ","شَجَرَتَهَآ","أَمۡ","نَحۡنُ","ٱلۡمُنشِـُٔونَ"],"w":["Is it you","who produced","its tree","or","We","(are) the Producers"],"t":["a-antum","anshatum","shajaratahā","am","naḥnu","l-munshiūna"],"p":[1,2,3,4,5,6],"en":"Is it you who produced its tree, or are We the producer"},{"a":["نَحۡنُ","جَعَلۡنَٰهَا","تَذۡكِرَةࣰ","وَمَتَٰعࣰا","لِّلۡمُقۡوِينَ"],"w":["We","have made it","a reminder","and a provision","for the wayfarers in the desert"],"t":["naḥnu","jaʿalnāhā","tadhkiratan","wamatāʿan","lil'muq'wīna"],"p":[1,2,3,4,5],"en":"We have made it a reminder and provision for the travelers"},{"a":["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"w":["So glorify","(the) name","(of) your Lord","the Most Great"],"t":["fasabbiḥ","bi-is'mi","rabbika","l-ʿaẓīmi"],"p":[1,2,3,4],"en":"So exalt the name of your Lord, the Most Great"},{"a":["۞فَلَآ","أُقۡسِمُ","بِمَوَٰقِعِ","ٱلنُّجُومِ"],"w":["But nay","I swear","by setting","(of) the stars"],"t":["falā","uq'simu","bimawāqiʿi","l-nujūmi"],"p":[1,2,3,4],"en":"Then I swear by the setting of the stars"},{"a":["وَإِنَّهُۥ","لَقَسَمࣱ","لَّوۡ","تَعۡلَمُونَ","عَظِيمٌ"],"w":["And indeed, it","(is) surely an oath","if","you know ","great"],"t":["wa-innahu","laqasamun","law","taʿlamūna","ʿaẓīmun"],"p":[1,2,3,4,5],"en":"And indeed, it is an oath - if you could know - [most] great"},{"a":["إِنَّهُۥ","لَقُرۡءَانࣱ","كَرِيمࣱ"],"w":["Indeed, it","(is) surely, a Quran","noble"],"t":["innahu","laqur'ānun","karīmun"],"p":[1,2,3],"en":"Indeed, it is a noble Qur'an"},{"a":["فِي","كِتَٰبࣲ","مَّكۡنُونࣲ"],"w":["In","a Book","well-guarded"],"t":["fī","kitābin","maknūnin"],"p":[1,2,3],"en":"In a Register well-protected"},{"a":["لَّا","يَمَسُّهُۥٓ","إِلَّا","ٱلۡمُطَهَّرُونَ"],"w":["None","touch it","except","the purified"],"t":["lā","yamassuhu","illā","l-muṭaharūna"],"p":[1,2,3,4],"en":"None touch it except the purified"},{"a":["تَنزِيلࣱ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"w":["A Revelation","from","(the) Lord","(of) the worlds"],"t":["tanzīlun","min","rabbi","l-ʿālamīna"],"p":[1,2,3,4],"en":"[It is] a revelation from the Lord of the worlds"},{"a":["أَفَبِهَٰذَا","ٱلۡحَدِيثِ","أَنتُم","مُّدۡهِنُونَ"],"w":["Then is it to this","statement","that you","(are) indifferent"],"t":["afabihādhā","l-ḥadīthi","antum","mud'hinūna"],"p":[1,2,3,4],"en":"Then is it to this statement that you are indifferent"},{"a":["وَتَجۡعَلُونَ","رِزۡقَكُمۡ","أَنَّكُمۡ","تُكَذِّبُونَ"],"w":["And you make","your provision","that you","deny"],"t":["watajʿalūna","riz'qakum","annakum","tukadhibūna"],"p":[1,2,3,4],"en":"And make [the thanks for] your provision that you deny [the Provider]"},{"a":["فَلَوۡلَآ","إِذَا","بَلَغَتِ","ٱلۡحُلۡقُومَ"],"w":["Then why not","when","it reaches","the throat"],"t":["falawlā","idhā","balaghati","l-ḥul'qūma"],"p":[1,2,3,4],"en":"Then why, when the soul at death reaches the throat"},{"a":["وَأَنتُمۡ","حِينَئِذࣲ","تَنظُرُونَ"],"w":["And you","(at) that time","look on"],"t":["wa-antum","ḥīna-idhin","tanẓurūna"],"p":[1,2,3],"en":"And you are at that time looking on"},{"a":["وَنَحۡنُ","أَقۡرَبُ","إِلَيۡهِ","مِنكُمۡ","وَلَٰكِن","لَّا","تُبۡصِرُونَ"],"w":["And We","(are) nearer","to him","than you","but","you (do) not see","you (do) not see"],"t":["wanaḥnu","aqrabu","ilayhi","minkum","walākin","lā","tub'ṣirūna"],"p":[1,2,3,4,5,6,7],"en":"And Our angels are nearer to him than you, but you do not see"},{"a":["فَلَوۡلَآ","إِن","كُنتُمۡ","غَيۡرَ","مَدِينِينَ"],"w":["Then why not","if","you are","not","to be recompensed"],"t":["falawlā","in","kuntum","ghayra","madīnīna"],"p":[1,2,3,4,5],"en":"Then why do you not, if you are not to be recompensed"},{"a":["تَرۡجِعُونَهَآ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"w":["Bring it back","if","you are","truthful"],"t":["tarjiʿūnahā","in","kuntum","ṣādiqīna"],"p":[1,2,3,4],"en":"Bring it back, if you should be truthful"},{"a":["فَأَمَّآ","إِن","كَانَ","مِنَ","ٱلۡمُقَرَّبِينَ"],"w":["Then","if","he was","of","those brought near"],"t":["fa-ammā","in","kāna","mina","l-muqarabīna"],"p":[1,2,3,4,5],"en":"And if the deceased was of those brought near to Allah"},{"a":["فَرَوۡحࣱ","وَرَيۡحَانࣱ","وَجَنَّتُ","نَعِيمࣲ"],"w":["Then rest","and bounty","and a Garden","(of) Pleasure"],"t":["farawḥun","warayḥānun","wajannatu","naʿīmin"],"p":[1,2,3,4],"en":"Then [for him is] rest and bounty and a garden of pleasure"},{"a":["وَأَمَّآ","إِن","كَانَ","مِنۡ","أَصۡحَٰبِ","ٱلۡيَمِينِ"],"w":["And","if","he was","of","(the) companions","(of) the right"],"t":["wa-ammā","in","kāna","min","aṣḥābi","l-yamīni"],"p":[1,2,3,4,5,6],"en":"And if he was of the companions of the right"},{"a":["فَسَلَٰمࣱ","لَّكَ","مِنۡ","أَصۡحَٰبِ","ٱلۡيَمِينِ"],"w":["Then, peace","for you","[from]","(the) companions","(of) the right"],"t":["fasalāmun","laka","min","aṣḥābi","l-yamīni"],"p":[1,2,3,4,5],"en":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right"},{"a":["وَأَمَّآ","إِن","كَانَ","مِنَ","ٱلۡمُكَذِّبِينَ","ٱلضَّآلِّينَ"],"w":["But","if","he was","of","the deniers","the astray"],"t":["wa-ammā","in","kāna","mina","l-mukadhibīna","l-ḍālīna"],"p":[1,2,3,4,5,6],"en":"But if he was of the deniers [who were] astray"},{"a":["فَنُزُلࣱ","مِّنۡ","حَمِيمࣲ"],"w":["Then, hospitality","of","(the) scalding water"],"t":["fanuzulun","min","ḥamīmin"],"p":[1,2,3],"en":"Then [for him is] accommodation of scalding water"},{"a":["وَتَصۡلِيَةُ","جَحِيمٍ"],"w":["And burning","(in) Hellfire"],"t":["wataṣliyatu","jaḥīmin"],"p":[1,2],"en":"And burning in Hellfire"},{"a":["إِنَّ","هَٰذَا","لَهُوَ","حَقُّ","ٱلۡيَقِينِ"],"w":["Indeed","this","surely, it","(is the) truth","certain"],"t":["inna","hādhā","lahuwa","ḥaqqu","l-yaqīni"],"p":[1,2,3,4,5],"en":"Indeed, this is the true certainty"},{"a":["فَسَبِّحۡ","بِٱسۡمِ","رَبِّكَ","ٱلۡعَظِيمِ"],"w":["So glorify","(the) name","(of) your Lord","the Most Great"],"t":["fasabbiḥ","bi-is'mi","rabbika","l-ʿaẓīmi"],"p":[1,2,3,4],"en":"So exalt the name of your Lord, the Most Great"}]}