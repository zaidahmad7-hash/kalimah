{"n":105,"ar":"الفيل","name":"Al-Fil","mean":"The Elephant","type":"meccan","v":[{"a":["أَلَمۡ","تَرَ","كَيۡفَ","فَعَلَ","رَبُّكَ","بِأَصۡحَٰبِ","ٱلۡفِيلِ"],"w":["Have not","you seen","how","dealt","your Lord","with (the) Companions","(of the) Elephant"],"t":["alam","tara","kayfa","faʿala","rabbuka","bi-aṣḥābi","l-fīli"],"p":[1,2,3,4,5,6,7],"en":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant"},{"a":["أَلَمۡ","يَجۡعَلۡ","كَيۡدَهُمۡ","فِي","تَضۡلِيلࣲ"],"w":["Did not","He make","their plan","go","astray"],"t":["alam","yajʿal","kaydahum","fī","taḍlīlin"],"p":[1,2,3,4,5],"en":"Did He not make their plan into misguidance"},{"a":["وَأَرۡسَلَ","عَلَيۡهِمۡ","طَيۡرًا","أَبَابِيلَ"],"w":["And He sent","against them","birds","(in) flocks"],"t":["wa-arsala","ʿalayhim","ṭayran","abābīla"],"p":[1,2,3,4],"en":"And He sent against them birds in flocks"},{"a":["تَرۡمِيهِم","بِحِجَارَةࣲ","مِّن","سِجِّيلࣲ"],"w":["Striking them","with stones","of","baked clay"],"t":["tarmīhim","biḥijāratin","min","sijjīlin"],"p":[1,2,3,4],"en":"Striking them with stones of hard clay"},{"a":["فَجَعَلَهُمۡ","كَعَصۡفࣲ","مَّأۡكُولِۭ"],"w":["Then He made them","like straw","eaten up"],"t":["fajaʿalahum","kaʿaṣfin","makūlin"],"p":[1,2,3],"en":"And He made them like eaten straw"}]}