{"n":93,"ar":"الضحى","name":"Ad-Duhaa","mean":"The Morning Hours","type":"meccan","v":[{"a":["وَٱلضُّحَىٰ"],"w":["By the morning brightness"],"t":["wal-ḍuḥā"],"p":[1],"en":"By the morning brightness"},{"a":["وَٱلَّيۡلِ","إِذَا","سَجَىٰ"],"w":["And the night","when","it covers with darkness"],"t":["wa-al-layli","idhā","sajā"],"p":[1,2,3],"en":"And [by] the night when it covers with darkness"},{"a":["مَا","وَدَّعَكَ","رَبُّكَ","وَمَا","قَلَىٰ"],"w":["Not","has forsaken you","your Lord","and not","He is displeased"],"t":["mā","waddaʿaka","rabbuka","wamā","qalā"],"p":[1,2,3,4,5],"en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you]"},{"a":["وَلَلۡأٓخِرَةُ","خَيۡرࣱ","لَّكَ","مِنَ","ٱلۡأُولَىٰ"],"w":["And surely the Hereafter","(is) better","for you","than","the first"],"t":["walalākhiratu","khayrun","laka","mina","l-ūlā"],"p":[1,2,3,4,5],"en":"And the Hereafter is better for you than the first [life]"},{"a":["وَلَسَوۡفَ","يُعۡطِيكَ","رَبُّكَ","فَتَرۡضَىٰٓ"],"w":["And soon","will give you","your Lord","then you will be satisfied"],"t":["walasawfa","yuʿ'ṭīka","rabbuka","fatarḍā"],"p":[1,2,3,4],"en":"And your Lord is going to give you, and you will be satisfied"},{"a":["أَلَمۡ","يَجِدۡكَ","يَتِيمࣰا","فَـَٔاوَىٰ"],"w":["Did not","He find you","an orphan","and give shelter"],"t":["alam","yajid'ka","yatīman","faāwā"],"p":[1,2,3,4],"en":"Did He not find you an orphan and give [you] refuge"},{"a":["وَوَجَدَكَ","ضَآلࣰّا","فَهَدَىٰ"],"w":["And He found you","lost","so He guided"],"t":["wawajadaka","ḍāllan","fahadā"],"p":[1,2,3],"en":"And He found you lost and guided [you]"},{"a":["وَوَجَدَكَ","عَآئِلࣰا","فَأَغۡنَىٰ"],"w":["And He found you","in need","so He made self-sufficient"],"t":["wawajadaka","ʿāilan","fa-aghnā"],"p":[1,2,3],"en":"And He found you poor and made [you] self-sufficient"},{"a":["فَأَمَّا","ٱلۡيَتِيمَ","فَلَا","تَقۡهَرۡ"],"w":["So as for","the orphan","then (do) not","oppress"],"t":["fa-ammā","l-yatīma","falā","taqhar"],"p":[1,2,3,4],"en":"So as for the orphan, do not oppress [him]"},{"a":["وَأَمَّا","ٱلسَّآئِلَ","فَلَا","تَنۡهَرۡ"],"w":["And as for","one who asks","then (do) not","repel"],"t":["wa-ammā","l-sāila","falā","tanhar"],"p":[1,2,3,4],"en":"And as for the petitioner, do not repel [him]"},{"a":["وَأَمَّا","بِنِعۡمَةِ","رَبِّكَ","فَحَدِّثۡ"],"w":["But as for","(the) Favor","(of) your Lord","narrate"],"t":["wa-ammā","biniʿ'mati","rabbika","faḥaddith"],"p":[1,2,3,4],"en":"But as for the favor of your Lord, report [it]"}]}