{"n":109,"ar":"الكافرون","name":"Al-Kafirun","mean":"The Disbelievers","type":"meccan","v":[{"a":["قُلۡ","يَـٰٓأَيُّهَا","ٱلۡكَٰفِرُونَ"],"w":["Say","O","disbelievers"],"t":["qul","yāayyuhā","l-kāfirūna"],"p":[1,2,3],"en":"Say, \"O disbelievers"},{"a":["لَآ","أَعۡبُدُ","مَا","تَعۡبُدُونَ"],"w":["Not","I worship","what","you worship"],"t":["lā","aʿbudu","mā","taʿbudūna"],"p":[1,2,3,4],"en":"I do not worship what you worship"},{"a":["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"w":["And not","you","(are) worshippers","(of) what","I worship"],"t":["walā","antum","ʿābidūna","mā","aʿbudu"],"p":[1,2,3,4,5],"en":"Nor are you worshippers of what I worship"},{"a":["وَلَآ","أَنَا۠","عَابِدࣱ","مَّا","عَبَدتُّمۡ"],"w":["And not","I am","a worshipper","(of) what","you worship"],"t":["walā","anā","ʿābidun","mā","ʿabadttum"],"p":[1,2,3,4,5],"en":"Nor will I be a worshipper of what you worship"},{"a":["وَلَآ","أَنتُمۡ","عَٰبِدُونَ","مَآ","أَعۡبُدُ"],"w":["And not","you","(are) worshippers","(of) what","I worship"],"t":["walā","antum","ʿābidūna","mā","aʿbudu"],"p":[1,2,3,4,5],"en":"Nor will you be worshippers of what I worship"},{"a":["لَكُمۡ","دِينُكُمۡ","وَلِيَ","دِينِ"],"w":["For you","(is) your religion","and for me","(is) my religion"],"t":["lakum","dīnukum","waliya","dīni"],"p":[1,2,3,4],"en":"For you is your religion, and for me is my religion"}]}